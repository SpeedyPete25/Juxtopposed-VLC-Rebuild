+    // The equalizer as a card that opens into Preamp and the ten bands, each
+    // a dB field over a slider (Figma "Audio - Equalizer"), with an on/off
+    // switch and the presets on top
+    component EqualizerCard: ColumnLayout {
+        id: eqCard
+
+        property var eq: VLCSettings.equalizer()
+        property bool expanded: false
+
+        spacing: 0
+
+        ColorContext { id: eqTheme; colorSet: ColorContext.Window }
+        ColorContext { id: eqView; colorSet: ColorContext.View }
+        ColorContext { id: eqField; colorSet: ColorContext.Slider }
+
+        function applyPreset(preset) {
+            eq = VLCSettings.applyEqualizerPreset(preset)
+        }
+
+        // Header: name, on/off, open/close
+        Rectangle {
+            Layout.fillWidth: true
+            implicitHeight: VLCStyle.dp(48, VLCStyle.scale)
+
+            radius: VLCStyle.dp(6, VLCStyle.scale)
+            color: eqTheme.bg.secondary
+
+            TapHandler { onTapped: eqCard.expanded = !eqCard.expanded }
+
+            Accessible.role: Accessible.Button
+            Accessible.name: eqCard.expanded ? qsTr("Collapse equalizer") : qsTr("Expand equalizer")
+            Accessible.onPressAction: eqCard.expanded = !eqCard.expanded
+
+            T.Label {
+                anchors.left: parent.left
+                anchors.leftMargin: VLCStyle.dp(16, VLCStyle.scale)
+                anchors.verticalCenter: parent.verticalCenter
+                text: eqCard.expanded ? qsTr("Collapse Settings") : qsTr("Equalizer")
+                color: eqView.fg.primary
+                font.pixelSize: VLCStyle.fontSize_large
+            }
+
+            T.Switch {
+                id: eqSwitch
+
+                anchors.right: chevron.left
+                anchors.rightMargin: VLCStyle.dp(12, VLCStyle.scale)
+                anchors.verticalCenter: parent.verticalCenter
+
+                // the Templates switch does not size itself from its indicator
+                implicitWidth: indicator.implicitWidth
+                implicitHeight: indicator.implicitHeight
+
+                checked: eqCard.eq.enabled
+
+                Accessible.name: qsTr("Equalizer")
+
+                // react to the state itself: accessibility toggles do not emit toggled()
+                onCheckedChanged: {
+                    if (checked === eqCard.eq.enabled)
+                        return
+                    VLCSettings.setEqualizerEnabled(checked)
+                    eqCard.eq = Object.assign({}, eqCard.eq, { enabled: checked })
+                }
+
+                indicator: Rectangle {
+                    implicitWidth: VLCStyle.dp(36, VLCStyle.scale)
+                    implicitHeight: VLCStyle.dp(20, VLCStyle.scale)
+                    radius: height / 2
+                    color: eqSwitch.checked ? eqField.bg.secondary : eqField.bg.primary
+                    border.width: VLCStyle.border
+                    border.color: eqSwitch.checked ? eqTheme.accent : eqView.border
+
+                    Rectangle {
+                        x: eqSwitch.checked ? parent.width - width - VLCStyle.dp(4, VLCStyle.scale) : VLCStyle.dp(4, VLCStyle.scale)
+                        anchors.verticalCenter: parent.verticalCenter
+                        width: VLCStyle.dp(12, VLCStyle.scale)
+                        height: width
+                        radius: width / 2
+                        color: eqSwitch.checked ? eqTheme.accent : eqTheme.fg.secondary
+
+                        Behavior on x { NumberAnimation { duration: VLCStyle.duration_short } }
+                    }
+                }
+            }
+
+            Widgets.IconLabel {
+                id: chevron
+
+                anchors.right: parent.right
+                anchors.rightMargin: VLCStyle.dp(10, VLCStyle.scale)
+                anchors.verticalCenter: parent.verticalCenter
+
+                text: eqCard.expanded ? VLCIcons.chevron_up : VLCIcons.chevron_down
+                color: eqView.fg.primary
+                font.pixelSize: VLCStyle.icon_normal
+            }
+        }
+
+        ColumnLayout {
+            Layout.fillWidth: true
+            Layout.topMargin: VLCStyle.dp(12, VLCStyle.scale)
+
+            visible: eqCard.expanded
+            enabled: eqCard.eq.enabled
+            opacity: enabled ? 1.0 : 0.5
+            spacing: VLCStyle.dp(10, VLCStyle.scale)
+
+            T.ComboBox {
+                id: presetBox
+
+                Layout.fillWidth: true
+                implicitHeight: VLCStyle.dp(36, VLCStyle.scale)
+
+                model: eqCard.eq.presets
+                textRole: "text"
+                valueRole: "value"
+                currentIndex: eqCard.eq.presets.findIndex((p) => p.value === eqCard.eq.preset)
+                displayText: currentIndex >= 0 ? currentText : qsTr("Custom")
+
+                Accessible.name: qsTr("Equalizer preset")
+
+                onActivated: (index) => eqCard.applyPreset(eqCard.eq.presets[index].value)
+
+                background: Rectangle {
+                    radius: VLCStyle.dp(4, VLCStyle.scale)
+                    color: eqField.bg.primary
+                }
+
+                contentItem: T.Label {
+                    leftPadding: VLCStyle.dp(14, VLCStyle.scale)
+                    rightPadding: VLCStyle.dp(40, VLCStyle.scale)
+                    verticalAlignment: Text.AlignVCenter
+                    text: presetBox.displayText
+                    color: eqView.fg.primary
+                    font.pixelSize: VLCStyle.fontSize_large
+                    elide: Text.ElideRight
+                }
+
+                indicator: Widgets.IconLabel {
+                    x: presetBox.width - width - VLCStyle.dp(12, VLCStyle.scale)
+                    anchors.verticalCenter: parent.verticalCenter
+                    text: VLCIcons.chevron_down
+                    color: eqView.fg.primary
+                    font.pixelSize: VLCStyle.icon_normal
+                }
+
+                delegate: T.ItemDelegate {
+                    required property var modelData
+                    required property int index
+
+                    width: presetBox.width - 2 * VLCStyle.dp(4, VLCStyle.scale)
+                    implicitHeight: VLCStyle.dp(32, VLCStyle.scale)
+
+                    highlighted: presetBox.highlightedIndex === index
+
+                    background: Rectangle {
+                        radius: VLCStyle.dp(3, VLCStyle.scale)
+                        color: (parent.highlighted || parent.hovered) ? eqView.border : "transparent"
+                    }
+
+                    contentItem: T.Label {
+                        leftPadding: VLCStyle.dp(10, VLCStyle.scale)
+                        verticalAlignment: Text.AlignVCenter
+                        text: modelData.text
+                        color: index === presetBox.currentIndex ? eqTheme.accent : eqView.fg.primary
+                        font.pixelSize: VLCStyle.fontSize_large
+                    }
+                }
+
+                popup: T.Popup {
+                    y: presetBox.height + VLCStyle.dp(4, VLCStyle.scale)
+                    width: presetBox.width
+                    implicitHeight: Math.min(contentItem.implicitHeight + 2 * padding, VLCStyle.dp(320, VLCStyle.scale))
+                    padding: VLCStyle.dp(4, VLCStyle.scale)
+
+                    contentItem: ListView {
+                        clip: true
+                        implicitHeight: contentHeight
+                        model: presetBox.popup.visible ? presetBox.delegateModel : null
+                        currentIndex: presetBox.highlightedIndex
+                        boundsBehavior: Flickable.StopAtBounds
+                    }
+
+                    background: Rectangle {
+                        radius: VLCStyle.dp(6, VLCStyle.scale)
+                        color: eqTheme.bg.secondary
+                        border.width: VLCStyle.border
+                        border.color: eqView.border
+                    }
+                }
+            }
+
+            BandSlider {
+                Layout.fillWidth: true
+                label: qsTr("Preamp")
+                value: eqCard.eq.preamp
+                onMoved: (dB) => VLCSettings.setEqualizerPreamp(dB)
+            }
+
+            Repeater {
+                model: eqCard.eq.bands.length
+
+                BandSlider {
+                    required property int index
+
+                    Layout.fillWidth: true
+                    label: eqCard.eq.labels[index]
+                    value: eqCard.eq.bands[index]
+                    onMoved: (dB) => VLCSettings.setEqualizerBand(index, dB)
+                }
+            }
+        }
+    }
+
+    // One equalizer row: name and dB field, then a -20 to +20 dB slider
+    component BandSlider: ColumnLayout {
+        id: band
+
+        property string label
+        property real value: 0
+        signal moved(real dB)
+
+        spacing: VLCStyle.dp(6, VLCStyle.scale)
+
+        ColorContext { id: bsTheme; colorSet: ColorContext.Window }
+        ColorContext { id: bsField; colorSet: ColorContext.Slider }
+        ColorContext { id: bsView; colorSet: ColorContext.View }
+
+        function set(dB) {
+            const v = Math.round(Math.max(-20, Math.min(20, dB)) * 10) / 10
+            value = v
+            moved(v)
+        }
+
+        RowLayout {
+            Layout.fillWidth: true
+
+            T.Label {
+                Layout.fillWidth: true
+                text: band.label
+                color: bsView.fg.primary
+                font.pixelSize: VLCStyle.fontSize_large
+            }
+
+            Rectangle {
+                implicitWidth: VLCStyle.dp(140, VLCStyle.scale)
+                implicitHeight: VLCStyle.dp(36, VLCStyle.scale)
+                radius: VLCStyle.dp(4, VLCStyle.scale)
+                color: bsField.bg.primary
+                border.width: dbInput.activeFocus ? VLCStyle.border : 0
+                border.color: bsTheme.accent
+
+                TextInput {
+                    id: dbInput
+
+                    anchors.fill: parent
+                    anchors.leftMargin: VLCStyle.dp(14, VLCStyle.scale)
+                    anchors.rightMargin: VLCStyle.dp(40, VLCStyle.scale)
+                    verticalAlignment: TextInput.AlignVCenter
+                    selectByMouse: true
+                    clip: true
+
+                    text: band.value.toFixed(1)
+                    color: bsView.fg.primary
+                    font.pixelSize: VLCStyle.fontSize_normal
+                    validator: DoubleValidator { bottom: -20; top: 20; decimals: 1; locale: "C" }
+
+                    Accessible.name: band.label
+
+                    onEditingFinished: {
+                        const dB = parseFloat(text)
+                        if (!isNaN(dB))
+                            band.set(dB)
+                        text = Qt.binding(() => band.value.toFixed(1))
+                    }
+                }
+
+                T.Label {
+                    anchors.right: parent.right
+                    anchors.rightMargin: VLCStyle.dp(14, VLCStyle.scale)
+                    anchors.verticalCenter: parent.verticalCenter
+                    text: qsTr("dB")
+                    color: bsTheme.fg.secondary
+                    font.pixelSize: VLCStyle.fontSize_normal
+                }
+            }
+        }
+
+        T.Slider {
+            id: bandSlider
+
+            Layout.fillWidth: true
+            implicitHeight: VLCStyle.dp(24, VLCStyle.scale)
+
+            from: -20
+            to: 20
+            stepSize: 0.1
+            value: band.value
+            live: true
+
+            onMoved: band.set(value)
+
+            background: Rectangle {
+                x: bandSlider.leftPadding
+                y: bandSlider.topPadding + (bandSlider.availableHeight - height) / 2
+                width: bandSlider.availableWidth
+                height: VLCStyle.dp(12, VLCStyle.scale)
+                radius: VLCStyle.dp(3, VLCStyle.scale)
+                color: bsField.bg.primary
+
+                // filled up to the handle
+                Rectangle {
+                    width: bandSlider.visualPosition * parent.width
+                    height: parent.height
+                    radius: parent.radius
+                    color: bsField.bg.secondary
+                }
+
+                // 0 dB mark
+                Rectangle {
+                    anchors.centerIn: parent
+                    width: VLCStyle.dp(2, VLCStyle.scale)
+                    height: parent.height
+                    color: bsView.border
+                }
+            }
+
+            handle: Rectangle {
+                x: bandSlider.leftPadding + bandSlider.visualPosition * (bandSlider.availableWidth - width)
+                y: bandSlider.topPadding + (bandSlider.availableHeight - height) / 2
+                width: VLCStyle.dp(8, VLCStyle.scale)
+                height: VLCStyle.dp(24, VLCStyle.scale)
+                radius: VLCStyle.dp(3, VLCStyle.scale)
+                color: bsTheme.accent
+            }
+        }
+    }
+
