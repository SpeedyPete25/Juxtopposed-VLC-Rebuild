+// Juxtopposed: the equalizer of the quick settings sidebar, doing what the
+// classic Equalizer panel does: the playing audio output's variables change
+// live and the configuration keeps the values for the next files.
+
+static QStringList equalizerBands(qt_intf_t *p_intf)
+{
+    QStringList bands;
+    const SharedAOut aout = p_intf->p_mainPlayerController->getAout();
+    char *value = nullptr;
+    if (aout && var_Type(aout.get(), "equalizer-bands") == VLC_VAR_STRING)
+        value = var_GetString(aout.get(), "equalizer-bands");
+    if (!value || !*value)
+    {
+        free(value);
+        value = config_GetPsz("equalizer-bands");
+    }
+    if (value)
+    {
+        bands = QString::fromUtf8(value).split(' ', Qt::SkipEmptyParts);
+        free(value);
+    }
+    while (bands.size() < EQZ_BANDS_MAX)
+        bands << QStringLiteral("0");
+    return bands.mid(0, EQZ_BANDS_MAX);
+}
+
+static bool equalizerInFilters(const char *filters)
+{
+    return filters && QString::fromUtf8(filters).split(':', Qt::SkipEmptyParts)
+                          .contains(QLatin1String("equalizer"));
+}
+
+QVariantMap VLCSettings::equalizer() const
+{
+    qt_intf_t *p_intf = m_intf;
+    const SharedAOut aout = p_intf->p_mainPlayerController->getAout();
+
+    char *filters = aout ? var_GetNonEmptyString(aout.get(), "audio-filter")
+                         : config_GetPsz("audio-filter");
+    const bool enabled = equalizerInFilters(filters);
+    free(filters);
+
+    double preamp = config_GetFloat("equalizer-preamp");
+    if (aout && var_Type(aout.get(), "equalizer-preamp") != 0)
+        preamp = var_GetFloat(aout.get(), "equalizer-preamp");
+
+    char *preset = aout && var_Type(aout.get(), "equalizer-preset") != 0
+                 ? var_GetString(aout.get(), "equalizer-preset")
+                 : config_GetPsz("equalizer-preset");
+
+    QVariantList bands;
+    for (const QString &band : equalizerBands(p_intf))
+        bands << QLocale::c().toDouble(band);
+
+    // VLC's own band frequencies, or the ISO ones (equalizer-vlcfreqs)
+    const QStringList labels = config_GetInt("equalizer-vlcfreqs")
+        ? QStringList{ qtr("60 Hz"), qtr("170 Hz"), qtr("310 Hz"), qtr("600 Hz"), qtr("1 KHz"),
+                       qtr("3 KHz"), qtr("6 KHz"), qtr("12 KHz"), qtr("14 KHz"), qtr("16 KHz") }
+        : QStringList{ qtr("31 Hz"), qtr("63 Hz"), qtr("125 Hz"), qtr("250 Hz"), qtr("500 Hz"),
+                       qtr("1 KHz"), qtr("2 KHz"), qtr("4 KHz"), qtr("8 KHz"), qtr("16 KHz") };
+
+    QVariantList presets;
+    for (int i = 0; i < NB_PRESETS; ++i)
+        presets << QVariantMap{ { QStringLiteral("value"), QString::fromUtf8(preset_list[i]) },
+                                { QStringLiteral("text"), qfut(preset_list_text[i]) } };
+
+    QVariantMap result{
+        { QStringLiteral("enabled"), enabled },
+        { QStringLiteral("preamp"), preamp },
+        { QStringLiteral("bands"), bands },
+        { QStringLiteral("labels"), labels },
+        { QStringLiteral("preset"), QString::fromUtf8(preset ? preset : "") },
+        { QStringLiteral("presets"), presets } };
+    free(preset);
+    return result;
+}
+
+void VLCSettings::setEqualizerEnabled(bool enabled)
+{
+    qt_intf_t *p_intf = m_intf;
+
+    char *filters = config_GetPsz("audio-filter");
+    QStringList list = QString::fromUtf8(filters ? filters : "").split(':', Qt::SkipEmptyParts);
+    free(filters);
+    list.removeAll(QStringLiteral("equalizer"));
+    if (enabled)
+        list << QStringLiteral("equalizer");
+    config_PutPsz("audio-filter", qtu(list.join(':')));
+
+    vlc_player_aout_EnableFilter(p_intf->p_player, "equalizer", enabled);
+    m_saveTimer.start();
+}
+
+void VLCSettings::setEqualizerPreamp(double dB)
+{
+    qt_intf_t *p_intf = m_intf;
+    if (const SharedAOut aout = p_intf->p_mainPlayerController->getAout())
+        var_SetFloat(aout.get(), "equalizer-preamp", dB);
+    config_PutFloat("equalizer-preamp", dB);
+    m_saveTimer.start();
+}
+
+void VLCSettings::setEqualizerBand(int index, double dB)
+{
+    if (index < 0 || index >= EQZ_BANDS_MAX)
+        return;
+
+    qt_intf_t *p_intf = m_intf;
+    QStringList bands = equalizerBands(p_intf);
+    bands[index] = QLocale::c().toString(dB);
+    const QByteArray value = bands.join(' ').toUtf8();
+
+    if (const SharedAOut aout = p_intf->p_mainPlayerController->getAout())
+        var_SetString(aout.get(), "equalizer-bands", value.constData());
+    config_PutPsz("equalizer-bands", value.constData());
+    m_saveTimer.start();
+}
+
+QVariantMap VLCSettings::applyEqualizerPreset(const QString &preset)
+{
+    qt_intf_t *p_intf = m_intf;
+
+    for (int i = 0; i < NB_PRESETS; ++i)
+    {
+        if (preset != QLatin1String(preset_list[i]))
+            continue;
+
+        QStringList bands;
+        for (int j = 0; j < eqz_preset_10b[i].i_band; ++j)
+            bands << QLocale::c().toString(eqz_preset_10b[i].f_amp[j]);
+        const QByteArray value = bands.join(' ').toUtf8();
+
+        if (const SharedAOut aout = p_intf->p_mainPlayerController->getAout())
+        {
+            var_SetFloat(aout.get(), "equalizer-preamp", eqz_preset_10b[i].f_preamp);
+            var_SetString(aout.get(), "equalizer-bands", value.constData());
+            var_SetString(aout.get(), "equalizer-preset", preset_list[i]);
+        }
+        config_PutFloat("equalizer-preamp", eqz_preset_10b[i].f_preamp);
+        config_PutPsz("equalizer-bands", value.constData());
+        config_PutPsz("equalizer-preset", preset_list[i]);
+        m_saveTimer.start();
+        break;
+    }
+    return equalizer();
+}
+
 QString VLCSettings::keyFromEvent(int key, int modifiers, const QString &text) const
 {
     switch (key)
