+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * ( at your option ) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston MA 02110-1301, USA.
+ *****************************************************************************/
+import QtQuick
+import QtQuick.Templates as T
+
+import VLC.MainInterface
+import VLC.Style
+import VLC.Widgets as Widgets
+
+// Juxtopposed: one row of the side panel library: a thumbnail, cover or icon
+// and the name. rowData is a library item or a { name, icon } entry, rowKind
+// the kind of list it belongs to (see SidePanelLibrary).
+T.ItemDelegate {
+    id: row
+
+    property var rowData
+    property string rowKind
+
+    readonly property string image: rowData.thumbnail || rowData.cover || rowData.small_cover || ""
+    readonly property bool isVideo: rowKind === "folderVideos" || rowKind === "recentVideos"
+                                    || rowKind === "playlistItems"
+
+    readonly property string fallbackIcon: {
+        switch (rowKind) {
+        case "videoFolders": return VLCIcons.folder
+        case "artists": return VLCIcons.artist
+        case "albums": return VLCIcons.topbar_music
+        case "genres": return VLCIcons.lists
+        case "playlists": return VLCIcons.playlist
+        }
+        return isVideo ? VLCIcons.topbar_video : VLCIcons.album_cover
+    }
+
+    implicitHeight: VLCStyle.dp(42, VLCStyle.scale)
+
+    text: rowData.title || rowData.name || ""
+
+    Accessible.name: text
+
+    ColorContext { id: rowView; colorSet: ColorContext.View }
+    ColorContext { id: rowWindow; colorSet: ColorContext.Window }
+
+    background: Rectangle {
+        radius: VLCStyle.dp(4, VLCStyle.scale)
+        color: row.hovered ? rowView.bg.secondary : "transparent"
+    }
+
+    contentItem: Item {
+        Item {
+            id: thumb
+
+            anchors.left: parent.left
+            anchors.leftMargin: VLCStyle.dp(6, VLCStyle.scale)
+            anchors.verticalCenter: parent.verticalCenter
+            width: row.isVideo ? VLCStyle.dp(32, VLCStyle.scale) : VLCStyle.dp(24, VLCStyle.scale)
+            height: VLCStyle.dp(24, VLCStyle.scale)
+
+            Image {
+                id: cover
+
+                anchors.fill: parent
+                visible: row.image.length > 0 && status === Image.Ready
+                source: row.image
+                asynchronous: true
+                fillMode: Image.PreserveAspectCrop
+                sourceSize: Qt.size(width * 2, height * 2)
+            }
+
+            Widgets.IconLabel {
+                anchors.centerIn: parent
+                visible: !cover.visible
+                text: row.rowData.icon ?? row.fallbackIcon
+                color: rowWindow.fg.secondary
+                font.pixelSize: VLCStyle.icon_normal
+            }
+        }
+
+        T.Label {
+            anchors.left: thumb.right
+            anchors.leftMargin: VLCStyle.dp(12, VLCStyle.scale)
+            anchors.right: parent.right
+            anchors.verticalCenter: parent.verticalCenter
+
+            // songs and albums read "title - artist", as in the design
+            text: row.rowData.main_artist ? qsTr("%1 - %2").arg(row.text).arg(row.rowData.main_artist)
+                                          : row.text
+            color: row.hovered ? rowView.fg.primary : rowWindow.fg.secondary
+            font.pixelSize: VLCStyle.fontSize_normal
+            elide: Text.ElideRight
+        }
+    }
+}
