index 0000000..cef68f0
--- /dev/null
+++ b/modules/gui/qt/player/qml/SidePanelLibraryRow.qml
@@ -0,0 +1,107 @@
+/*****************************************************************************
+ * Copyright (C) 2026 VLC authors and VideoLAN
+ *
