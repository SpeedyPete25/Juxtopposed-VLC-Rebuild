index 2afa064..7b3af52 100644
--- a/modules/gui/qt/player/qml/Player.qml
+++ b/modules/gui/qt/player/qml/Player.qml
@@ -1189,6 +1189,25 @@ FocusScope {
                 anchors.left: parent.left
             }
 
+            // Juxtopposed: the library, over the queue when the rail asks for it
