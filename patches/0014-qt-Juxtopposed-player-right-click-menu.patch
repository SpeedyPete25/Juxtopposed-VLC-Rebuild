+/* Juxtopposed: the two-tone (orange and gray) menu icons of the redesign */
+static QIcon juxtIcon( const char *name )
+{
+    return QIcon( QStringLiteral( ":/menu/juxt_%1.svg" ).arg( QLatin1String( name ) ) );
+}
+
+/* Juxtopposed: show the action's current VLC hotkey on the right of the entry */
+static void setHotkeyHint( QAction *action, const char *hotkey )
+{
+    char *value = config_GetPsz( hotkey );
+    if( !value )
+        return;
+    const QString first = qfu( value ).split( '\t' ).value( 0 );
+    free( value );
+
+    const uint_fast32_t code = vlc_str2keycode( qtu( first ) );
+    if( first.isEmpty() || code == KEY_UNSET )
+        return;
+    char *text = vlc_keycode2str( code, false );
+    if( text )
+    {
+        action->setShortcut( QKeySequence::fromString( qfu( text ) ) );
+        free( text );
+    }
+}
