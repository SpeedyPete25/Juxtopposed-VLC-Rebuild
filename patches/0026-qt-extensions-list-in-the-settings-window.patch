+QVariantList VLCSettings::extensions()
+{
+    ExtensionsManager *em = ExtensionsManager::getInstance(m_intf);
+    if (!m_extensionsHooked)
+    {
+        connect(em, &ExtensionsManager::extensionsUpdated, this, &VLCSettings::extensionsChanged);
+        m_extensionsHooked = true;
+    }
+    if (!em->isLoaded() && !em->cannotLoad())
+        em->loadExtensions();
+
+    QVariantList list;
+    extensions_manager_t *mgr = em->getManager();
+    if (!mgr)
+        return list;
+
+    QVector<extension_t *> found;
+    vlc_mutex_lock(&mgr->lock);
+    extension_t *ext;
+    ARRAY_FOREACH(ext, mgr->extensions)
+    {
+        QString description = qfu(ext->psz_description);
+        if (description.isEmpty())
+            description = qfu(ext->psz_shortdescription);
+        list.append(QVariantMap {
+            { "name", qfu(ext->psz_name) },
+            { "title", qfu(ext->psz_title) },
+            { "description", description },
+            { "author", qfu(ext->psz_author) },
+            { "version", qfu(ext->psz_version) },
+        });
+        found.append(ext);
+    }
+    vlc_mutex_unlock(&mgr->lock);
+
+    // asked outside the lock, as the extensions menu does
+    for (int i = 0; i < found.size(); ++i)
+    {
+        QVariantMap entry = list[i].toMap();
+        entry["active"] = extension_IsActivated(mgr, found[i]);
+        list[i] = entry;
+    }
+    return list;
+}
+
+void VLCSettings::runExtension(const QString &name)
+{
+    ExtensionsManager *em = ExtensionsManager::getInstance(m_intf);
+    extensions_manager_t *mgr = em->getManager();
+    if (!mgr)
+        return;
+
+    extension_t *target = nullptr;
+    vlc_mutex_lock(&mgr->lock);
+    extension_t *ext;
+    ARRAY_FOREACH(ext, mgr->extensions)
+    {
+        if (qfu(ext->psz_name) == name)
+        {
+            target = ext;
+            break;
+        }
+    }
+    vlc_mutex_unlock(&mgr->lock);
+    if (!target)
+        return;
+
+    // what the View menu entry of an extension does
+    if (extension_TriggerOnly(mgr, target))
+        extension_Trigger(mgr, target);
+    else if (!extension_IsActivated(mgr, target))
+        extension_Activate(mgr, target);
+    else
+        extension_Deactivate(mgr, target);
+
+    emit extensionsChanged();
+}
