 // Juxtopposed: the pages of the settings window, following the redesign.
 // Each row names a VLC option (read and written through VLCSettings) with
@@ -304,9 +305,18 @@ QtObject {
         {
             group: qsTr("System"), name: qsTr("Extensions"), title: qsTr("Extensions"),
             icon: VLCIcons.plugins,
+            // Every installed extension, then the old dialog for add-ons (skins
+            // and the like, from VLC's catalog) and VLC's own plugins
             sections: [
-                { title: qsTr("Extensions"), rows: [
-                    { special: "button", label: qsTr("Extensions, add-ons and plugins"), text: qsTr("Manage"), action: "plugins" }
+                { title: qsTr("Installed"), rows: VLCSettings.extensions.map((ext) => ({
+                    special: "extension", label: ext.title, ext: ext,
+                    info: [ext.description,
+                           [ext.version ? qsTr("Version %1").arg(ext.version) : "",
+                            ext.author ? qsTr("by %1").arg(ext.author) : ""].filter((t) => t).join(" ")]
+                          .filter((t) => t).join("\n\n")
+                })) },
+                { title: qsTr("More"), rows: [
+                    { special: "button", label: qsTr("Add-ons and plugins"), text: qsTr("Manage"), action: "plugins" }
                 ] }
             ],
             advanced: []
