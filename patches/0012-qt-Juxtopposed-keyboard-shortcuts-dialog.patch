+import QtQuick
+import QtQuick.Layouts
+import QtQuick.Templates as T
+
+import VLC.MainInterface
+import VLC.Style
+import VLC.Widgets as Widgets
+import VLC.Dialogs
+
+// Juxtopposed: the keyboard shortcuts dialog. Every VLC hotkey grouped by
+// what it does, with its hotkey and global hotkey. Edits are kept here until
+// Save writes them to the configuration; Cancel drops them.
+FocusScope {
+    id: root
+
+    signal closed()
+
+    // configuration name ("key-..." or "global-key-...") -> edited value
+    property var edits: ({})
+
+    // the field waiting for a key press, as its configuration name
+    property string capturing: ""
+
+    // what the last edit changed elsewhere, shown next to the buttons
+    property string note: ""
+
+    readonly property var entries: VLCSettings.hotkeys()
+
+    readonly property var _saved: {
+        const map = {}
+        for (const entry of entries) {
+            map[entry.name] = entry.value
+            map["global-" + entry.name] = entry.globalValue
+        }
+        return map
+    }
+
+    property var _rows: []
+
+    readonly property bool dirty: Object.keys(edits).length > 0
+
+    readonly property var groups: [
+        { name: qsTr("Basic"), match: /fullscreen|^key-position$|^key-intf|^key-quit|popup-menu/ },
+        { name: qsTr("Playback"), match: /play|pause|stop|next|prev|faster|slower|rate|jump|frame|record|loop|random|program/ },
+        { name: qsTr("Audio"), match: /vol|audio|mute/ },
+        { name: qsTr("Subtitles"), match: /sub/ },
+        { name: qsTr("Video"), match: /aspect|crop|zoom|deinterlace|snapshot|wallpaper|autoscale|scale|viewpoint|fov|roll|video/ },
+        { name: qsTr("Navigation"), match: /^key-nav-|title|chapter|disc-menu/ },
+        { name: qsTr("Bookmarks"), match: /bookmark/ }
+    ]
+
+    focus: true
+
+    Keys.onEscapePressed: root.closed()
+
+    Component.onCompleted: {
+        _refresh()
+        searchInput.forceActiveFocus()
+    }
+
+    readonly property ColorContext colorContext: ColorContext {
+        id: theme
+        colorSet: ColorContext.Window
+    }
+
+    ColorContext { id: viewTheme; colorSet: ColorContext.View }
+    ColorContext { id: fieldTheme; colorSet: ColorContext.Slider }
+    ColorContext { id: inputTheme; colorSet: ColorContext.TextField }
+    ColorContext { id: itemTheme; colorSet: ColorContext.Item }
+
+    function valueOf(cfg) {
+        return (cfg in edits) ? edits[cfg] : (_saved[cfg] ?? "")
+    }
+
+    function _keys(value) {
+        return (value ?? "").split("\t").filter((k) => k.length > 0 && k !== "Unset")
+    }
+
+    // a key as shown, letters in capitals as printed on the keys ("Ctrl+F")
+    function keyText(key) {
+        return VLCSettings.keyLabel(key).replace(/(^|\+)([a-z])$/, (m, p, c) => p + c.toUpperCase())
+    }
+
+    function labelOf(cfg) {
+        return _keys(valueOf(cfg)).map((k) => keyText(k)).join(", ")
+    }
+
+    function _textOf(name) {
+        const entry = entries.find((e) => e.name === name)
+        return entry ? entry.text : name
+    }
+
+    // Set a field to one key, taking it away from any other action of the
+    // same column that used it
+    function assign(cfg, key) {
+        const next = Object.assign({}, edits)
+        const global = cfg.startsWith("global-")
+        const taken = []
+
+        if (key.length > 0) {
+            for (const entry of entries) {
+                const other = global ? "global-" + entry.name : entry.name
+                if (other === cfg)
+                    continue
+                const keys = _keys((other in next) ? next[other] : _saved[other])
+                if (keys.includes(key)) {
+                    next[other] = keys.filter((k) => k !== key).join("\t")
+                    taken.push(entry.text)
+                }
+            }
+        }
+
+        next[cfg] = key
+        if (next[cfg] === (_saved[cfg] ?? ""))
+            delete next[cfg]
+
+        edits = next
+        note = taken.length > 0 ? qsTr("%1 was removed from \"%2\"").arg(keyText(key)).arg(taken.join("\", \""))
+                                : ""
+    }
+
+    function save() {
+        for (const cfg in edits)
+            VLCSettings.setValue(cfg, edits[cfg])
+        edits = {}
+        root.closed()
+    }
+
+    // Rebuild the list for the search: group headers followed by their rows
+    function _refresh() {
+        const q = searchInput.text.trim().toLowerCase()
+        const scope = scopeBox.currentIndex
+
+        const matches = (entry) => {
+            if (q.length === 0)
+                return true
+            const action = entry.text.toLowerCase()
+            const hotkey = labelOf(entry.name).toLowerCase()
+            const global = labelOf("global-" + entry.name).toLowerCase()
+            switch (scope) {
+            case 1: return action.includes(q)
+            case 2: return hotkey.includes(q)
+            case 3: return global.includes(q)
+            default: return action.includes(q) || hotkey.includes(q) || global.includes(q)
+            }
+        }
+
+        const buckets = groups.map(() => [])
+        const other = []
+        for (const entry of entries) {
+            if (!matches(entry))
+                continue
+            const index = groups.findIndex((g) => g.match.test(entry.name))
+            if (index >= 0)
+                buckets[index].push(entry)
+            else
+                other.push(entry)
+        }
+
+        const rows = []
+        const push = (name, list) => {
+            if (list.length === 0)
+                return
+            rows.push({ header: name, first: rows.length === 0 })
+            list.forEach((entry) => rows.push(entry))
+        }
+        groups.forEach((g, i) => push(g.name, buckets[i]))
+        push(qsTr("Other"), other)
+
+        _rows = rows
+    }
+
+    // Dim the interface behind the dialog; clicking outside cancels it
+    Rectangle {
+        anchors.fill: parent
+        color: Qt.rgba(0, 0, 0, 0.5)
+
+        TapHandler { onTapped: root.closed() }
+    }
+
+    Rectangle {
+        id: card
+
+        anchors.centerIn: parent
+        width: Math.min(VLCStyle.dp(1048, VLCStyle.scale), root.width - 2 * VLCStyle.margin_large)
+        height: Math.min(VLCStyle.dp(800, VLCStyle.scale), root.height - 2 * VLCStyle.margin_large)
+
+        radius: VLCStyle.dp(14, VLCStyle.scale)
+        color: theme.bg.primary
+        clip: true
+
+        TapHandler { onTapped: root.capturing = "" }
+
+        Widgets.DefaultShadow { }
+
+        // Header: title, close, search and its scope
+        Rectangle {
+            id: header
+
+            anchors.left: parent.left
+            anchors.right: parent.right
+            anchors.top: parent.top
+
+            height: VLCStyle.dp(96, VLCStyle.scale)
+            radius: card.radius
+            color: fieldTheme.bg.primary
+
+            T.Label {
+                anchors.left: parent.left
+                anchors.leftMargin: VLCStyle.dp(19, VLCStyle.scale)
+                anchors.verticalCenter: closeButton.verticalCenter
+
+                text: qsTr("Keyboard Shortcuts")
+                color: itemTheme.fg.highlight
+                font.pixelSize: VLCStyle.fontSize_large
+            }
+
+            Widgets.IconToolButton {
+                id: closeButton
+
+                anchors.right: parent.right
+                anchors.rightMargin: VLCStyle.dp(9, VLCStyle.scale)
+                anchors.top: parent.top
+                anchors.topMargin: VLCStyle.dp(9, VLCStyle.scale)
+
+                text: VLCIcons.close
+                description: qsTr("Close")
+                font.pixelSize: VLCStyle.icon_normal
+
+                onClicked: root.closed()
+            }
+
+            Rectangle {
+                id: searchField
+
+                anchors.left: parent.left
+                anchors.leftMargin: VLCStyle.dp(9, VLCStyle.scale)
+                anchors.right: scopeBox.left
+                anchors.rightMargin: VLCStyle.dp(10, VLCStyle.scale)
+                anchors.bottom: parent.bottom
+                anchors.bottomMargin: VLCStyle.dp(9, VLCStyle.scale)
+
+                height: VLCStyle.dp(34, VLCStyle.scale)
+                radius: VLCStyle.dp(6, VLCStyle.scale)
+                color: theme.bg.secondary
+                border.width: searchInput.activeFocus ? VLCStyle.border : 0
+                border.color: theme.accent
+
+                Widgets.IconLabel {
+                    id: searchIcon
+
+                    anchors.left: parent.left
+                    anchors.leftMargin: VLCStyle.dp(8, VLCStyle.scale)
+                    anchors.verticalCenter: parent.verticalCenter
+
+                    text: VLCIcons.search
+                    color: inputTheme.fg.secondary
+                    font.pixelSize: VLCStyle.icon_normal
+                }
+
+                TextInput {
+                    id: searchInput
+
+                    anchors.left: searchIcon.right
+                    anchors.leftMargin: VLCStyle.dp(10, VLCStyle.scale)
+                    anchors.right: parent.right
+                    anchors.rightMargin: VLCStyle.dp(8, VLCStyle.scale)
+                    anchors.top: parent.top
+                    anchors.bottom: parent.bottom
+
+                    verticalAlignment: TextInput.AlignVCenter
+                    clip: true
+                    selectByMouse: true
+
+                    color: viewTheme.fg.primary
+                    selectionColor: fieldTheme.bg.secondary
+                    font.pixelSize: VLCStyle.fontSize_large
+
+                    Accessible.name: qsTr("Search Keyboard Shortcuts")
+
+                    onTextChanged: root._refresh()
+
+                    Keys.onEscapePressed: (event) => {
+                        if (text.length > 0) {
+                            text = ""
+                            event.accepted = true
+                        } else {
+                            event.accepted = false
+                        }
+                    }
+
+                    T.Label {
+                        anchors.verticalCenter: parent.verticalCenter
+                        visible: !searchInput.length
+                        text: qsTr("Search Keyboard Shortcuts...")
+                        color: inputTheme.fg.secondary
+                        font.pixelSize: VLCStyle.fontSize_large
+                    }
+                }
+            }
+
+            T.ComboBox {
+                id: scopeBox
+
+                anchors.right: parent.right
+                anchors.rightMargin: VLCStyle.dp(9, VLCStyle.scale)
+                anchors.verticalCenter: searchField.verticalCenter
+
+                width: VLCStyle.dp(200, VLCStyle.scale)
+                height: searchField.height
+
+                model: [ qsTr("All Fields"), qsTr("Action"), qsTr("Hotkey"), qsTr("Global Hotkey") ]
+
+                Accessible.name: qsTr("Search in")
+
+                onCurrentIndexChanged: root._refresh()
+
+                background: Rectangle {
+                    radius: VLCStyle.dp(6, VLCStyle.scale)
+                    color: theme.bg.secondary
+                    border.width: scopeBox.visualFocus ? VLCStyle.border : 0
+                    border.color: theme.accent
+                }
+
+                contentItem: T.Label {
+                    leftPadding: VLCStyle.dp(12, VLCStyle.scale)
+                    rightPadding: VLCStyle.dp(40, VLCStyle.scale)
+                    verticalAlignment: Text.AlignVCenter
+                    text: scopeBox.displayText
+                    color: viewTheme.fg.primary
+                    font.pixelSize: VLCStyle.fontSize_large
+                    elide: Text.ElideRight
+                }
+
+                indicator: Widgets.IconLabel {
+                    x: scopeBox.width - width - VLCStyle.dp(8, VLCStyle.scale)
+                    anchors.verticalCenter: parent.verticalCenter
+                    text: VLCIcons.chevron_down
+                    color: viewTheme.fg.primary
+                    font.pixelSize: VLCStyle.icon_normal
+                }
+
+                delegate: T.ItemDelegate {
+                    required property var modelData
+                    required property int index
+
+                    width: scopeBox.width - 2 * VLCStyle.dp(4, VLCStyle.scale)
+                    implicitHeight: VLCStyle.dp(32, VLCStyle.scale)
+
+                    highlighted: scopeBox.highlightedIndex === index
+
+                    background: Rectangle {
+                        radius: VLCStyle.dp(3, VLCStyle.scale)
+                        color: (parent.highlighted || parent.hovered) ? viewTheme.border : "transparent"
+                    }
+
+                    contentItem: T.Label {
+                        leftPadding: VLCStyle.dp(10, VLCStyle.scale)
+                        verticalAlignment: Text.AlignVCenter
+                        text: modelData
+                        color: index === scopeBox.currentIndex ? theme.accent : viewTheme.fg.primary
+                        font.pixelSize: VLCStyle.fontSize_large
+                    }
+                }
+
+                popup: T.Popup {
+                    y: scopeBox.height + VLCStyle.dp(4, VLCStyle.scale)
+                    width: scopeBox.width
+                    implicitHeight: contentItem.implicitHeight + 2 * padding
+                    padding: VLCStyle.dp(4, VLCStyle.scale)
+
+                    contentItem: ListView {
+                        clip: true
+                        implicitHeight: contentHeight
+                        model: scopeBox.popup.visible ? scopeBox.delegateModel : null
+                        currentIndex: scopeBox.highlightedIndex
+                        boundsBehavior: Flickable.StopAtBounds
+                    }
+
+                    background: Rectangle {
+                        radius: VLCStyle.dp(6, VLCStyle.scale)
+                        color: theme.bg.secondary
+                        border.width: VLCStyle.border
+                        border.color: viewTheme.border
+                    }
+                }
+            }
+
+            // square off the bottom corners
+            Rectangle {
+                anchors.left: parent.left
+                anchors.right: parent.right
+                anchors.bottom: parent.bottom
+                height: parent.radius
+                color: parent.color
+                z: -1
+            }
+        }
+
+        // Column headings
+        Item {
+            id: columns
+
+            anchors.left: parent.left
+            anchors.leftMargin: VLCStyle.dp(20, VLCStyle.scale)
+            anchors.right: parent.right
+            anchors.rightMargin: VLCStyle.dp(20, VLCStyle.scale)
+            anchors.top: header.bottom
+            anchors.topMargin: VLCStyle.dp(20, VLCStyle.scale)
+
+            height: VLCStyle.dp(25, VLCStyle.scale)
+
+            // the two key columns, as in the design (379 and 738 of 1008)
+            readonly property real fieldWidth: Math.min(VLCStyle.dp(262, VLCStyle.scale), width * 0.27)
+            readonly property real globalX: width - fieldWidth
+            readonly property real hotkeyX: globalX - VLCStyle.dp(87, VLCStyle.scale) - fieldWidth
+
+            T.Label {
+                anchors.verticalCenter: parent.verticalCenter
+                text: qsTr("Action")
+                color: theme.fg.secondary
+                font.pixelSize: VLCStyle.fontSize_large
+            }
+
+            T.Label {
+                x: columns.hotkeyX
+                width: columns.fieldWidth
+                anchors.verticalCenter: parent.verticalCenter
+                horizontalAlignment: Text.AlignHCenter
+                text: qsTr("Hotkey")
+                color: theme.fg.secondary
+                font.pixelSize: VLCStyle.fontSize_large
+            }
+
+            T.Label {
+                x: columns.globalX
+                width: columns.fieldWidth
+                anchors.verticalCenter: parent.verticalCenter
+                horizontalAlignment: Text.AlignHCenter
+                text: qsTr("Global Hotkey")
+                color: theme.fg.secondary
+                font.pixelSize: VLCStyle.fontSize_large
+            }
+
+            Rectangle {
+                anchors.left: parent.left
+                anchors.right: parent.right
+                anchors.top: parent.bottom
+                anchors.topMargin: VLCStyle.dp(20, VLCStyle.scale) - height
+                height: VLCStyle.border
+                color: viewTheme.border
+            }
+        }
+
+        ListView {
+            id: list
+
+            anchors.left: columns.left
+            anchors.right: parent.right
+            anchors.rightMargin: VLCStyle.dp(8, VLCStyle.scale)
+            anchors.top: columns.bottom
+            anchors.topMargin: VLCStyle.dp(20, VLCStyle.scale)
+            anchors.bottom: footer.top
+
+            clip: true
+            boundsBehavior: Flickable.StopAtBounds
+            model: root._rows
+            reuseItems: false
+
+            T.ScrollBar.vertical: Widgets.ScrollBarExt { }
+
+            delegate: Loader {
+                required property var modelData
+
+                width: columns.width
+                sourceComponent: modelData.header !== undefined ? headerDelegate : rowDelegate
+
+                Component {
+                    id: headerDelegate
+
+                    Item {
+                        implicitHeight: VLCStyle.dp(modelData.first ? 48 : 88, VLCStyle.scale)
+
+                        Rectangle {
+                            visible: !modelData.first
+                            anchors.left: parent.left
+                            anchors.right: parent.right
+                            y: VLCStyle.dp(6, VLCStyle.scale)
+                            height: VLCStyle.border
+                            color: viewTheme.border
+                        }
+
+                        T.Label {
+                            anchors.left: parent.left
+                            anchors.bottom: parent.bottom
+                            anchors.bottomMargin: VLCStyle.dp(20, VLCStyle.scale)
+                            text: modelData.header
+                            color: theme.fg.secondary
+                            font.pixelSize: VLCStyle.fontSize_xlarge
+                        }
+                    }
+                }
+
+                Component {
+                    id: rowDelegate
+
+                    Item {
+                        implicitHeight: VLCStyle.dp(47, VLCStyle.scale)
+
+                        T.Label {
+                            anchors.left: parent.left
+                            anchors.right: hotkeyField.left
+                            anchors.rightMargin: VLCStyle.dp(16, VLCStyle.scale)
+                            y: (VLCStyle.dp(33, VLCStyle.scale) - height) / 2
+
+                            text: modelData.text
+                            color: viewTheme.fg.primary
+                            font.pixelSize: VLCStyle.fontSize_large
+                            elide: Text.ElideRight
+                        }
+
+                        KeyField {
+                            id: hotkeyField
+                            x: columns.hotkeyX
+                            width: columns.fieldWidth
+                            cfg: modelData.name
+                            actionText: modelData.text
+                        }
+
+                        KeyField {
+                            x: columns.globalX
+                            width: columns.fieldWidth
+                            cfg: "global-" + modelData.name
+                            actionText: modelData.text + " " + qsTr("(global)")
+                        }
+                    }
+                }
+            }
+
+            T.Label {
+                anchors.centerIn: parent
+                visible: list.count === 0
+                text: qsTr("No shortcuts match \"%1\"").arg(searchInput.text)
+                color: theme.fg.secondary
+                font.pixelSize: VLCStyle.fontSize_large
+            }
+        }
+
+        // Cancel, the conflict note, Save
+        Item {
+            id: footer
+
+            anchors.left: parent.left
+            anchors.right: parent.right
+            anchors.bottom: parent.bottom
+
+            height: VLCStyle.dp(72, VLCStyle.scale)
+
+            FooterButton {
+                id: cancelButton
+
+                anchors.left: parent.left
+                anchors.leftMargin: VLCStyle.dp(20, VLCStyle.scale)
+                anchors.verticalCenter: parent.verticalCenter
+
+                text: qsTr("Cancel")
+                onClicked: root.closed()
+            }
+
+            T.Label {
+                anchors.left: cancelButton.right
+                anchors.right: saveButton.left
+                anchors.margins: VLCStyle.dp(20, VLCStyle.scale)
+                anchors.verticalCenter: parent.verticalCenter
+
+                horizontalAlignment: Text.AlignHCenter
+                text: root.note.length > 0 ? root.note
+                                           : root.dirty ? qsTr("Changes apply after VLC restarts")
+                                                        : ""
+                color: theme.fg.secondary
+                font.pixelSize: VLCStyle.fontSize_normal
+                elide: Text.ElideRight
+            }
+
+            FooterButton {
+                id: saveButton
+
+                anchors.right: parent.right
+                anchors.rightMargin: VLCStyle.dp(20, VLCStyle.scale)
+                anchors.verticalCenter: parent.verticalCenter
+
+                text: qsTr("Save")
+                enabled: root.dirty
+                onClicked: root.save()
+            }
+        }
+    }
+
+    // A hotkey field: the key centered, a pencil on the right. Clicking it
+    // waits for a key press; Escape stops waiting, the cross unsets it.
+    component KeyField: T.AbstractButton {
+        id: field
+
+        required property string cfg
+        property string actionText
+
+        readonly property bool waiting: root.capturing === cfg
+        readonly property string label: root.labelOf(cfg)
+        readonly property bool edited: cfg in root.edits
+
+        ColorContext { id: kfWindow; colorSet: ColorContext.Window }
+        ColorContext { id: kfField; colorSet: ColorContext.Slider }
+        ColorContext { id: kfView; colorSet: ColorContext.View }
+
+        implicitHeight: VLCStyle.dp(33, VLCStyle.scale)
+
+        focusPolicy: Qt.StrongFocus
+        text: label
+
+        Accessible.name: qsTr("Edit %1").arg(actionText)
+
+        onClicked: {
+            root.capturing = waiting ? "" : cfg
+            // a keyboard focus reason gives the field visualFocus, which
+            // keeps VLC's own hotkey handling away from the keys typed here
+            if (root.capturing === cfg)
+                forceActiveFocus(Qt.TabFocusReason)
+        }
+
+        onActiveFocusChanged: {
+            if (!activeFocus && waiting)
+                root.capturing = ""
+        }
+
+        Keys.onShortcutOverride: (event) => event.accepted = field.waiting
+
+        Keys.onPressed: (event) => {
+            if (!field.waiting)
+                return
+            event.accepted = true
+            if (event.key === Qt.Key_Escape && event.modifiers === Qt.NoModifier) {
+                root.capturing = ""
+                return
+            }
+            const key = VLCSettings.keyFromEvent(event.key, event.modifiers, event.text)
+            if (key.length === 0)
+                return
+            root.assign(field.cfg, key)
+            root.capturing = ""
+        }
+
+        background: Rectangle {
+            radius: VLCStyle.dp(6, VLCStyle.scale)
+            color: kfField.bg.primary
+            border.width: field.waiting ? VLCStyle.border : 0
+            border.color: kfWindow.accent
+            opacity: (field.hovered && !field.waiting) ? 0.8 : 1.0
+        }
+
+        contentItem: Item {
+            T.Label {
+                anchors.centerIn: parent
+                width: parent.width - 2 * VLCStyle.dp(36, VLCStyle.scale)
+                horizontalAlignment: Text.AlignHCenter
+                text: field.waiting ? qsTr("Press a key...") : field.label
+                color: field.waiting ? kfWindow.fg.secondary
+                                     : field.edited ? kfWindow.accent : kfView.fg.primary
+                font.pixelSize: VLCStyle.fontSize_large
+                font.family: field.waiting ? Qt.application.font.family : "monospace"
+                elide: Text.ElideRight
+            }
+
+            Widgets.IconLabel {
+                anchors.right: parent.right
+                anchors.rightMargin: VLCStyle.dp(5, VLCStyle.scale)
+                anchors.verticalCenter: parent.verticalCenter
+
+                visible: !field.waiting
+                text: VLCIcons.edit
+                color: kfWindow.fg.secondary
+                font.pixelSize: VLCStyle.icon_normal
+            }
+
+            Widgets.IconToolButton {
+                anchors.right: parent.right
+                anchors.verticalCenter: parent.verticalCenter
+
+                visible: field.waiting && field.label.length > 0
+                text: VLCIcons.close
+                description: qsTr("Unset")
+                font.pixelSize: VLCStyle.icon_small
+
+                onClicked: {
+                    root.assign(field.cfg, "")
+                    root.capturing = ""
+                }
+            }
+        }
+    }
+
+    // Cancel / Save (100x32, dim until there is something to save)
+    component FooterButton: T.AbstractButton {
+        id: footerButton
+
+        ColorContext { id: fbWindow; colorSet: ColorContext.Window }
+        ColorContext { id: fbView; colorSet: ColorContext.View }
+
+        implicitWidth: VLCStyle.dp(100, VLCStyle.scale)
+        implicitHeight: VLCStyle.dp(32, VLCStyle.scale)
+
+        background: Rectangle {
+            radius: VLCStyle.dp(4, VLCStyle.scale)
+            color: fbWindow.bg.secondary
+            opacity: footerButton.hovered ? 0.8 : 1.0
+        }
+
+        contentItem: T.Label {
+            horizontalAlignment: Text.AlignHCenter
+            verticalAlignment: Text.AlignVCenter
+            text: footerButton.text
+            color: footerButton.enabled ? fbView.fg.primary : fbWindow.fg.secondary
+            opacity: footerButton.enabled ? 1.0 : 0.5
+            font.pixelSize: VLCStyle.fontSize_large
+            font.weight: Font.DemiBold
+        }
+    }
+}
