+QVariantList VLCSettings::hotkeys() const
+{
+    QVariantList result;
+
+    module_t *main = module_get_main();
+    if (!main)
+        return result;
+
+    unsigned count;
+    module_config_t *const config = module_config_get(main, &count);
+    if (!config)
+        return result;
+
+    for (unsigned i = 0; i < count; i++)
+    {
+        const module_config_t *item = &config[i];
+        if (item->i_type != CONFIG_ITEM_KEY || !item->psz_name || !item->psz_text)
+            continue;
+        const QString name = qfu(item->psz_name);
+        if (name.startsWith(QLatin1String("global-")))
+            continue;
+
+        char *value = config_GetPsz(item->psz_name);
+        const QByteArray globalName = QByteArrayLiteral("global-") + item->psz_name;
+        char *globalValue = config_GetPsz(globalName.constData());
+
+        result.append(QVariantMap{
+            { QStringLiteral("name"), name },
+            { QStringLiteral("text"), qfut(item->psz_text) },
+            { QStringLiteral("value"), qfu(value ? value : "") },
+            { QStringLiteral("globalValue"), qfu(globalValue ? globalValue : "") } });
+
+        free(value);
+        free(globalValue);
+    }
+
+    module_config_free(config);
+    return result;
+}
+
+QString VLCSettings::keyFromEvent(int key, int modifiers, const QString &text) const
+{
+    switch (key)
+    {
+    case Qt::Key_Control: case Qt::Key_Shift: case Qt::Key_Alt:
+    case Qt::Key_Meta: case Qt::Key_AltGr: case Qt::Key_unknown:
+        return {};
+    }
+
+    QKeyEvent event(QEvent::KeyPress, key, Qt::KeyboardModifiers(modifiers), text);
+    const int code = qtEventToVLCKey(&event);
+    if (code == KEY_UNSET)
+        return {};
+
+    char *str = vlc_keycode2str(code, false);
+    const QString result = qfu(str ? str : "");
+    free(str);
+    return result;
+}
+
+QString VLCSettings::keyLabel(const QString &vlcKey) const
+{
+    if (vlcKey.isEmpty() || vlcKey == QLatin1String("Unset"))
+        return {};
+
+    const uint_fast32_t code = vlc_str2keycode(vlcKey.toUtf8().constData());
+    if (code == KEY_UNSET)
+        return vlcKey;
+
+    char *str = vlc_keycode2str(code, true);
+    const QString result = qfu(str ? str : "");
+    free(str);
+    return result.isEmpty() ? vlcKey : result;
+}
+
 void VLCSettings::resetAll()
 {
     config_ResetAll();
