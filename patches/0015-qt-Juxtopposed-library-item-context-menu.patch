diff --git a/modules/gui/qt/medialibrary/qml/MLContextMenu.qml b/modules/gui/qt/medialibrary/qml/MLContextMenu.qml
index b29052d..b55ce24 100644
--- a/modules/gui/qt/medialibrary/qml/MLContextMenu.qml
+++ b/modules/gui/qt/medialibrary/qml/MLContextMenu.qml
@@ -53,66 +53,85 @@ NativeMenu {
 
     // Settings
 
+    // Juxtopposed: the order, wording and icons of the redesign's file menu
+    // (Figma "file context menu"); VLC's extra entries follow with icons of
+    // the same family.
     actions: [{
             "text": qsTr("Play"),
+            "icon": "play",
             "action": addAndPlay
         }, {
             "text": qsTr("Play as audio"),
+            "icon": "audio",
             "action": playAsAudio,
             "visible": root.showPlayAsAudioAction
         }, {
             "text": qsTr("Play as album"),
+            "icon": "play",
             "action": playAsAlbum,
             "visible": root.showPlayAsAlbumAction &&
                        (root.model instanceof MLAudioModel)
         }, {
-            "text": qsTr("Enqueue"),
-            "action": enqueue
+            "text": qsTr("Mark as Watched"),
+            "icon": "watched",
+            "action": markSeen,
+            "visible": _showSeen
         }, {
-            "text": qsTr("Enqueue as album"),
-            "action": enqueueAsAlbum,
-            "visible": root.showPlayAsAlbumAction &&
-                       (root.model instanceof MLAudioModel)
+            "text": qsTr("Mark as Unwatched"),
+            "icon": "watched",
+            "action": markUnseen,
+            "visible": _showUnseen
         }, {
-            "text": qsTr("Add to favorites"),
+            "text": qsTr("Add to Favorites"),
+            "icon": "favorite",
             "action": addFavorite,
             "visible": _showAddFavorite
         }, {
-            "text": qsTr("Remove from favorites"),
+            "text": qsTr("Remove from Favorites"),
+            "icon": "favorite",
             "action": removeFavorite,
             "visible": _showRemoveFavorite
         }, {
-            "text": (root.showPlayAsAudioAction ? qsTr("Add to a video-only playlist") : qsTr("Add to an audio-only playlist")),
-            "action": (root.showPlayAsAudioAction ? root.addToVideoOnlyPlaylist : root.addToAudioOnlyPlaylist)
+            "text": qsTr("Stream"),
+            "icon": "stream",
+            "action": stream,
+            "visible": _hasMrl
         }, {
-            "text": qsTr("Add to a playlist"),
-            "action": addToAPlaylist
+            "text": qsTr("Convert"),
+            "icon": "convert",
+            "action": convert,
+            "visible": _hasMrl
         }, {
-            "text": qsTr("Mark as seen"),
-            "action": markSeen,
-            "visible": _showSeen
+            "text": qsTr("Add to Queue"),
+            "icon": "queue",
+            "action": enqueue
         }, {
-            "text": qsTr("Mark as unseen"),
-            "action": markUnseen,
-            "visible": _showUnseen
+            "text": qsTr("Add Album to Queue"),
+            "icon": "queue",
+            "action": enqueueAsAlbum,
+            "visible": root.showPlayAsAlbumAction &&
+                       (root.model instanceof MLAudioModel)
+        }, {
+            "text": qsTr("Add to Playlist"),
+            "icon": "playlist",
+            "action": addToAPlaylist
+        }, {
+            "text": (root.showPlayAsAudioAction ? qsTr("Add to a video-only playlist") : qsTr("Add to an audio-only playlist")),
+            "icon": "playlist",
+            "action": (root.showPlayAsAudioAction ? root.addToVideoOnlyPlaylist : root.addToAudioOnlyPlaylist)
         }, {
-            "text": qsTr("Open Containing Folder"),
+            "text": qsTr("Show in File Explorer"),
+            "icon": "folder",
             "action": openContainingFolder,
             "visible": _openContainingFolder
-        }, {
-            "text": qsTr("Delete"),
-            "action": deleteStream,
-            "visible": _deleteStream
         }, {
             "text": qsTr("Information"),
+            "icon": "info",
             "action": _signalShowInformation,
             "visible": showInformationAvailable
         },{
-            "text": qsTr("Delete File From System"),
-            "action": deleteFileFromSource,
-            "visible": _deleteFileFromSource
-        },{
-            "text": qsTr("Media Information"),
+            "text": qsTr("Properties & Metadata"),
+            "icon": "info",
             "action": function(dataList, options, indexes) {
                 DialogsProvider.mediaInfoDialog(dataList[0][idDataRole])
             },
@@ -120,6 +139,14 @@ NativeMenu {
                 return (dataList.length === 1)
                         && !(dataList[0][idDataRole].hasParent())
             }
+        }, {
+            "text": qsTr("Delete"),
+            "action": deleteStream,
+            "visible": _deleteStream
+        },{
+            "text": qsTr("Delete File From System"),
+            "action": deleteFileFromSource,
+            "visible": _deleteFileFromSource
         }
     ]
 
@@ -153,6 +180,15 @@ NativeMenu {
         model.ml.addToPlaylist(_mlIDList(dataList, root.albumIdDataRole), _playerOptions(options))
     }
 
+    // VLC's streaming and convert wizards, starting from these files
+    function stream(dataList, options, indexes) {
+        DialogsProvider.streamingDialog(_mrlList(dataList), true)
+    }
+
+    function convert(dataList, options, indexes) {
+        DialogsProvider.streamingDialog(_mrlList(dataList), false)
+    }
+
     function addToAudioOnlyPlaylist(dataList, options, indexes) {
         addToAPlaylist(dataList, options, indexes, MLPlaylistListModel.PLAYLIST_TYPE_AUDIO_ONLY)
     }
@@ -240,6 +276,14 @@ NativeMenu {
         return _checkRole(dataList, "isLocal", true)
     }
 
+    function _hasMrl(dataList, options, indexes) {
+        return dataList.length > 0 && dataList.every((data) => !!data.mrl)
+    }
+
+    function _mrlList(dataList) {
+        return dataList.map((data) => data.mrl)
+    }
+
     function _deleteStream(dataList,options, indexes) {
         return _checkRole(dataList, "isDeletable", true)
     }
diff --git a/modules/gui/qt/menus/qml_menu_wrapper.cpp b/modules/gui/qt/menus/qml_menu_wrapper.cpp
index 5a9ae2b..072623d 100644
--- a/modules/gui/qt/menus/qml_menu_wrapper.cpp
+++ b/modules/gui/qt/menus/qml_menu_wrapper.cpp
@@ -77,11 +77,19 @@ void StringListMenu::popup(const QPoint &point, const QVariantList &stringList)
 
     for (int i = 0; i != stringList.size(); ++i)
     {
-        const auto str = stringList[i].toString();
-        m->addAction(str, this, [this, i, str]()
+        // Juxtopposed: an entry is either its text or { text, icon }, the
+        // icon naming one of the redesign's menu icons (":/menu/juxt_<icon>.svg")
+        const QVariantMap entry = stringList[i].toMap();
+        const auto str = entry.isEmpty() ? stringList[i].toString()
+                                         : entry.value(QStringLiteral("text")).toString();
+        // a plain "&" in the text (file names, "Properties & Metadata") is not a mnemonic
+        QAction *action = m->addAction(QString(str).replace('&', QLatin1String("&&")), this, [this, i, str]()
         {
             emit selected(i, str);
         });
+        const QString icon = entry.value(QStringLiteral("icon")).toString();
+        if (!icon.isEmpty())
+            action->setIcon(QIcon(QStringLiteral(":/menu/juxt_%1.svg").arg(icon)));
     }
 
     m->popup(point);
