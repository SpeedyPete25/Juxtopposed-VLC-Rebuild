+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston MA 02110-1301, USA.
+ *****************************************************************************/
+import QtQuick
+import QtQuick.Layouts
+import QtQuick.Templates as T
+
+import VLC.MainInterface
+import VLC.Style
+import VLC.Widgets as Widgets
+import VLC.Dialogs
+
+// Juxtopposed: the redesigned settings window. Categories on the left
+// (App / Media / System), the selected page on the right with its basic
+// settings first and its advanced options below, and a search over all of them.
+FocusScope {
+    id: root
+
+    signal closed()
+
+    property int currentIndex: 0
+    property bool advancedShown: false
+
+    readonly property var categories: pages.categories
+    readonly property var page: categories[currentIndex]
+    readonly property bool searching: searchInput.text.trim().length > 0
+
+    // Categories with their group headings, as one flat list
+    readonly property var _navItems: {
+        const items = []
+        let group = ""
+        categories.forEach((category, index) => {
+            if (category.group !== group) {
+                group = category.group
+                items.push({ header: group })
+            }
+            items.push({ index: index, name: category.name, icon: category.icon })
+        })
+        return items
+    }
+
+    focus: true
+
+    onCurrentIndexChanged: {
+        advancedShown = false
+        content.contentY = 0
+    }
+
+    Keys.onEscapePressed: root.closed()
+
+    Component.onCompleted: searchInput.forceActiveFocus()
+
+    SettingsPages { id: pages }
+
+    readonly property ColorContext colorContext: ColorContext {
+        id: theme
+        colorSet: ColorContext.Window
+    }
+
+    ColorContext { id: viewTheme; colorSet: ColorContext.View }
+    ColorContext { id: fieldTheme; colorSet: ColorContext.Slider }
+    ColorContext { id: inputTheme; colorSet: ColorContext.TextField }
+    ColorContext { id: itemTheme; colorSet: ColorContext.Item }
+
+    // Rows of every page matching the search, by label or VLC's own wording
+    function _searchResults(query) {
+        const q = query.trim().toLowerCase()
+        const results = []
+        for (const category of categories) {
+            for (const section of category.sections) {
+                for (const row of section.rows) {
+                    let text = (row.label ?? "").toLowerCase()
+                    if (row.option) {
+                        const opt = VLCSettings.option(row.option)
+                        if (!opt.name)
+                            continue
+                        text += " " + (opt.text ?? "").toLowerCase() + " " + row.option
+                    }
+                    if (text.includes(q))
+                        results.push(row)
+                }
+            }
+        }
+        return results
+    }
+
+    // Dim the interface behind the window; clicking outside closes it
+    Rectangle {
+        anchors.fill: parent
+        color: Qt.rgba(0, 0, 0, 0.5)
+
+        TapHandler { onTapped: root.closed() }
+    }
+
+    Rectangle {
+        id: card
+
+        anchors.centerIn: parent
+        width: Math.min(VLCStyle.dp(1048, VLCStyle.scale), root.width - 2 * VLCStyle.margin_large)
+        height: Math.min(VLCStyle.dp(865, VLCStyle.scale), root.height - 2 * VLCStyle.margin_large)
+
+        radius: VLCStyle.dp(10, VLCStyle.scale)
+        color: theme.bg.primary
+
+        // Swallow clicks so they don't reach the backdrop
+        TapHandler {}
+
+        Widgets.DefaultShadow { }
+
+        // Left column: search and categories
+        ColumnLayout {
+            id: sideColumn
+
+            anchors.left: parent.left
+            anchors.top: parent.top
+            anchors.bottom: parent.bottom
+            anchors.margins: VLCStyle.dp(8, VLCStyle.scale)
+
+            width: VLCStyle.dp(194, VLCStyle.scale)
+            spacing: VLCStyle.dp(8, VLCStyle.scale)
+
+            Rectangle {
+                Layout.fillWidth: true
+                Layout.preferredHeight: VLCStyle.dp(36, VLCStyle.scale)
+
+                radius: VLCStyle.dp(6, VLCStyle.scale)
+                color: inputTheme.bg.primary
+                border.width: searchInput.activeFocus ? VLCStyle.border : 0
+                border.color: theme.accent
+
+                Widgets.IconLabel {
+                    id: searchIcon
+
+                    anchors.left: parent.left
+                    anchors.leftMargin: VLCStyle.dp(8, VLCStyle.scale)
+                    anchors.verticalCenter: parent.verticalCenter
+
+                    text: VLCIcons.search
+                    color: inputTheme.fg.secondary
+                    font.pixelSize: VLCStyle.icon_normal
+                }
+
+                TextInput {
+                    id: searchInput
+
+                    anchors.left: searchIcon.right
+                    anchors.leftMargin: VLCStyle.dp(8, VLCStyle.scale)
+                    anchors.right: parent.right
+                    anchors.rightMargin: VLCStyle.dp(8, VLCStyle.scale)
+                    anchors.top: parent.top
+                    anchors.bottom: parent.bottom
+
+                    verticalAlignment: TextInput.AlignVCenter
+                    clip: true
+                    selectByMouse: true
+
+                    color: viewTheme.fg.primary
+                    selectionColor: fieldTheme.bg.secondary
+                    font.pixelSize: VLCStyle.fontSize_large
+
+                    Keys.onEscapePressed: (event) => {
+                        if (text.length > 0) {
+                            text = ""
+                            event.accepted = true
+                        } else {
+                            event.accepted = false
+                        }
+                    }
+
+                    T.Label {
+                        anchors.verticalCenter: parent.verticalCenter
+                        visible: !searchInput.length
+                        text: qsTr("Search")
+                        color: inputTheme.fg.secondary
+                        font.pixelSize: VLCStyle.fontSize_large
+                    }
+                }
+            }
+
+            Rectangle {
+                Layout.fillWidth: true
+                Layout.fillHeight: true
+
+                radius: VLCStyle.dp(6, VLCStyle.scale)
+                color: theme.bg.secondary
+
+                ListView {
+                    id: categoryList
+
+                    anchors.fill: parent
+                    anchors.margins: VLCStyle.dp(6, VLCStyle.scale)
+
+                    clip: true
+                    boundsBehavior: Flickable.StopAtBounds
+                    model: root._navItems
+                    spacing: VLCStyle.dp(4, VLCStyle.scale)
+
+                    delegate: T.ItemDelegate {
+                        id: categoryItem
+
+                        required property var modelData
+
+                        readonly property bool isHeader: modelData.header !== undefined
+                        readonly property bool current: !isHeader && !root.searching && root.currentIndex === modelData.index
+
+                        width: categoryList.width
+                        implicitHeight: isHeader ? VLCStyle.dp(32, VLCStyle.scale) : VLCStyle.dp(40, VLCStyle.scale)
+
+                        enabled: !isHeader
+                        hoverEnabled: !isHeader
+
+                        text: modelData.header ?? modelData.name
+
+                        onClicked: {
+                            searchInput.text = ""
+                            root.currentIndex = modelData.index
+                        }
+
+                        background: Rectangle {
+                            radius: VLCStyle.dp(4, VLCStyle.scale)
+                            color: (categoryItem.current || categoryItem.hovered) ? itemTheme.bg.highlight : "transparent"
+                            opacity: categoryItem.current ? 1.0 : 0.5
+                        }
+
+                        contentItem: Row {
+                            leftPadding: VLCStyle.dp(10, VLCStyle.scale)
+                            spacing: VLCStyle.dp(12, VLCStyle.scale)
+
+                            T.Label {
+                                anchors.verticalCenter: parent.verticalCenter
+                                visible: categoryItem.isHeader
+                                text: categoryItem.modelData.header ?? ""
+                                color: theme.fg.secondary
+                                font.pixelSize: VLCStyle.fontSize_large
+                            }
+
+                            Widgets.IconLabel {
+                                anchors.verticalCenter: parent.verticalCenter
+                                visible: !categoryItem.isHeader
+                                text: categoryItem.modelData.icon ?? ""
+                                color: categoryItem.current ? theme.accent : viewTheme.fg.primary
+                                font.pixelSize: VLCStyle.icon_normal
+                            }
+
+                            T.Label {
+                                anchors.verticalCenter: parent.verticalCenter
+                                visible: !categoryItem.isHeader
+                                text: categoryItem.modelData.name ?? ""
+                                color: categoryItem.current ? itemTheme.fg.highlight : viewTheme.fg.primary
+                                font.pixelSize: VLCStyle.fontSize_large
+                            }
+                        }
+                    }
+                }
+            }
+        }
+
+        // Right side: page header and content
+        Rectangle {
+            id: header
+
+            anchors.left: sideColumn.right
+            anchors.leftMargin: VLCStyle.dp(8, VLCStyle.scale)
+            anchors.right: parent.right
+            anchors.rightMargin: VLCStyle.dp(8, VLCStyle.scale)
+            anchors.top: parent.top
+            anchors.topMargin: VLCStyle.dp(8, VLCStyle.scale)
+
+            height: VLCStyle.dp(48, VLCStyle.scale)
+            radius: VLCStyle.dp(6, VLCStyle.scale)
+            color: fieldTheme.bg.primary
+
+            T.Label {
+                anchors.left: parent.left
+                anchors.leftMargin: VLCStyle.dp(24, VLCStyle.scale)
+                anchors.verticalCenter: parent.verticalCenter
+
+                text: root.searching ? qsTr("Search results") : root.page.title
+                color: itemTheme.fg.highlight
+                font.pixelSize: VLCStyle.fontSize_xlarge
+            }
+
+            Widgets.IconToolButton {
+                anchors.right: parent.right
+                anchors.rightMargin: VLCStyle.dp(8, VLCStyle.scale)
+                anchors.verticalCenter: parent.verticalCenter
+
+                text: VLCIcons.close
+                description: qsTr("Close")
+                font.pixelSize: VLCStyle.icon_normal
+
+                onClicked: root.closed()
+            }
+        }
+
+        Rectangle {
+            anchors.left: header.left
+            anchors.right: header.right
+            anchors.top: header.bottom
+            anchors.bottom: parent.bottom
+            anchors.bottomMargin: VLCStyle.dp(8, VLCStyle.scale)
+
+            radius: VLCStyle.dp(6, VLCStyle.scale)
+            color: viewTheme.bg.primary
+
+            Flickable {
+                id: content
+
+                anchors.fill: parent
+                anchors.margins: VLCStyle.dp(24, VLCStyle.scale)
+
+                clip: true
+                contentHeight: pageColumn.implicitHeight
+                boundsBehavior: Flickable.StopAtBounds
+
+                T.ScrollBar.vertical: Widgets.ScrollBarExt { }
+
+                ColumnLayout {
+                    id: pageColumn
+
+                    width: content.width - VLCStyle.dp(12, VLCStyle.scale)
+                    spacing: VLCStyle.dp(12, VLCStyle.scale)
+
+                    // Search results
+                    Repeater {
+                        model: root.searching ? root._searchResults(searchInput.text) : []
+
+                        SettingsRow {
+                            required property var modelData
+                            Layout.fillWidth: true
+                            row: modelData
+                        }
+                    }
+
+                    T.Label {
+                        visible: root.searching && root._searchResults(searchInput.text).length === 0
+                        text: qsTr("No settings match \"%1\"").arg(searchInput.text)
+                        color: theme.fg.secondary
+                        font.pixelSize: VLCStyle.fontSize_large
+                    }
+
+                    // Basic settings of the page, by section
+                    Repeater {
+                        model: root.searching ? [] : root.page.sections
+
+                        ColumnLayout {
+                            required property var modelData
+
+                            Layout.fillWidth: true
+                            Layout.bottomMargin: VLCStyle.dp(16, VLCStyle.scale)
+                            spacing: VLCStyle.dp(12, VLCStyle.scale)
+
+                            SectionTitle { text: modelData.title }
+
+                            Repeater {
+                                model: modelData.rows
+
+                                SettingsRow {
+                                    required property var modelData
+                                    Layout.fillWidth: true
+                                    row: modelData
+                                }
+                            }
+                        }
+                    }
+
+                    // Advanced Options: the page's extra actions, then every
+                    // core option of its VLC sections
+                    T.AbstractButton {
+                        id: advancedButton
+
+                        Layout.fillWidth: true
+                        implicitHeight: VLCStyle.dp(36, VLCStyle.scale)
+
+                        visible: !root.searching && ((root.page.advanced ?? []).length > 0 || (root.page.extras ?? []).length > 0)
+
+                        text: qsTr("Advanced Options")
+
+                        onClicked: root.advancedShown = !root.advancedShown
+
+                        background: Rectangle {
+                            radius: VLCStyle.dp(4, VLCStyle.scale)
+                            color: theme.bg.secondary
+                            opacity: advancedButton.hovered ? 0.8 : 1.0
+                        }
+
+                        contentItem: Item {
+                            Row {
+                                anchors.centerIn: parent
+                                spacing: VLCStyle.dp(12, VLCStyle.scale)
+
+                                T.Label {
+                                    anchors.verticalCenter: parent.verticalCenter
+                                    text: qsTr("Advanced Options")
+                                    color: viewTheme.fg.primary
+                                    font.pixelSize: VLCStyle.fontSize_large
+                                }
+
+                                Widgets.IconLabel {
+                                    anchors.verticalCenter: parent.verticalCenter
+                                    text: root.advancedShown ? VLCIcons.chevron_up : VLCIcons.chevron_down
+                                    color: viewTheme.fg.primary
+                                    font.pixelSize: VLCStyle.icon_normal
+                                }
+                            }
+                        }
+                    }
+
+                    Repeater {
+                        model: (!root.searching && root.advancedShown) ? (root.page.extras ?? []) : []
+
+                        SettingsRow {
+                            required property var modelData
+                            Layout.fillWidth: true
+                            row: modelData
+                        }
+                    }
+
+                    Repeater {
+                        model: (!root.searching && root.advancedShown) ? VLCSettings.coreOptions(root.page.advanced ?? []) : []
+
+                        Loader {
+                            required property var modelData
+
+                            Layout.fillWidth: true
+                            Layout.topMargin: modelData.section ? VLCStyle.dp(12, VLCStyle.scale) : 0
+
+                            sourceComponent: modelData.section ? advancedSection : advancedRow
+
+                            Component {
+                                id: advancedSection
+                                SectionTitle { text: modelData.section }
+                            }
+
+                            Component {
+                                id: advancedRow
+                                SettingsRow { row: ({ option: modelData.name }) }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    component SectionTitle: T.Label {
+        ColorContext { id: titleTheme; colorSet: ColorContext.Item }
+
+        color: titleTheme.fg.highlight
+        font.pixelSize: VLCStyle.fontSize_xlarge
+        font.weight: Font.DemiBold
+    }
+}
