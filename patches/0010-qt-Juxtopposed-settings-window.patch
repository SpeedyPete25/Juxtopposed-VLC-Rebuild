+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston MA 02110-1301, USA.
+ *****************************************************************************/
+
+#ifndef VLC_QT_VLC_SETTINGS_HPP
+#define VLC_QT_VLC_SETTINGS_HPP
+
+#include <QObject>
+#include <QTimer>
+#include <QVariant>
+
+#include "qt.hpp"
+
+// Juxtopposed: lets the QML settings window read and write VLC options by
+// name, and list the core options of VLC's settings sections.
+class VLCSettings : public QObject
+{
+    Q_OBJECT
+
+public:
+    VLCSettings(qt_intf_t *intf, QObject *parent = nullptr);
+
+    // Describes an option: { name, type, value, defaultValue, text, longText,
+    // min, max, choices: [{ value, text }] }. Empty if the option does not exist.
+    // type is one of: bool, int, float, color, string, password, file, directory,
+    // font, module, key.
+    Q_INVOKABLE QVariantMap option(const QString &name) const;
+
+    // Writes an option and schedules saving the configuration file.
+    Q_INVOKABLE bool setValue(const QString &name, const QVariant &value);
+
+    // The core options of the given VLC subcategories (SUBCAT_*), in order,
+    // as [{ section: "..."}, or { name: "..." }].
+    Q_INVOKABLE QVariantList coreOptions(const QVariantList &subcategories) const;
+
+    // Asks for a file or folder for a path option, stores it and returns it
+    // (empty if cancelled).
+    Q_INVOKABLE QString browse(const QString &name);
+
+    Q_INVOKABLE void resetAll();
+    Q_INVOKABLE void openConfigFolder() const;
+
+signals:
+    // Emitted when every option may have changed (reset)
+    void reset();
+
+private:
+    void save();
+
+    qt_intf_t *m_intf;
+    QTimer m_saveTimer;
+};
+
+#endif
