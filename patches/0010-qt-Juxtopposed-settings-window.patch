+import QtQuick
+import QtQuick.Layouts
+import QtQuick.Templates as T
+
+import VLC.MainInterface
+import VLC.Style
+import VLC.Widgets as Widgets
+import VLC.Dialogs
+
+// Juxtopposed: one row of the settings window: a label with an info icon,
+// and a control picked from the type of the VLC option it edits.
+Item {
+    id: root
+
+    // { option, label, choices, unit } or { special, label, text, action, accent }
+    required property var row
+
+    // Option description from VLCSettings, refreshed after a reset
+    property var opt: _load()
+
+    readonly property bool special: !!row.special
+    readonly property var choices: row.choices ?? opt?.choices ?? []
+    readonly property string label: row.label ?? opt?.text ?? ""
+
+    readonly property real controlWidth: VLCStyle.dp(320, VLCStyle.scale)
+
+    // Rows for options missing from this VLC build are left out
+    visible: special || !!opt?.name
+
+    implicitWidth: layout.implicitWidth
+    implicitHeight: visible ? Math.max(layout.implicitHeight, VLCStyle.dp(36, VLCStyle.scale)) : 0
+
+    function _load() {
+        return row.option ? VLCSettings.option(row.option) : null
+    }
+
+    function _set(value) {
+        if (VLCSettings.setValue(row.option, value))
+            opt = _load()
+    }
+
+    Connections {
+        target: VLCSettings
+        function onReset() { root.opt = root._load() }
+    }
+
+    readonly property ColorContext colorContext: ColorContext {
+        id: theme
+        colorSet: ColorContext.Window
+    }
+
+    ColorContext {
+        id: fieldTheme
+        colorSet: ColorContext.Slider   // #090909 fields, #371F06 accent fills
+    }
+
+    ColorContext {
+        id: viewTheme
+        colorSet: ColorContext.View
+    }
+
+    RowLayout {
+        id: layout
+
+        anchors.fill: parent
+        spacing: VLCStyle.dp(16, VLCStyle.scale)
+
+        Row {
+            Layout.fillWidth: true
+            Layout.alignment: Qt.AlignVCenter
+
+            spacing: VLCStyle.dp(8, VLCStyle.scale)
+
+            T.Label {
+                id: labelText
+
+                anchors.verticalCenter: parent.verticalCenter
+                width: Math.min(implicitWidth, root.width - root.controlWidth - VLCStyle.dp(48, VLCStyle.scale))
+
+                text: root.label
+                color: viewTheme.fg.primary
+                font.pixelSize: VLCStyle.fontSize_large
+                elide: Text.ElideRight
+            }
+
+            // Every setting has an info icon with VLC's explanation
+            Widgets.IconLabel {
+                id: infoIcon
+
+                anchors.verticalCenter: parent.verticalCenter
+
+                visible: !!root.opt?.longText || (!!root.opt?.text && root.opt.text !== root.label)
+                text: VLCIcons.info
+                color: theme.fg.secondary
+                font.pixelSize: VLCStyle.icon_small * 1.4
+
+                HoverHandler { id: infoHover }
+
+                T.ToolTip.visible: infoHover.hovered
+                T.ToolTip.delay: 0
+                T.ToolTip.text: {
+                    const parts = []
+                    if (root.opt?.text && root.opt.text !== root.label)
+                        parts.push(root.opt.text)
+                    if (root.opt?.longText)
+                        parts.push(root.opt.longText)
+                    return parts.join("\n\n")
+                }
+            }
+        }
+
+        Loader {
+            Layout.alignment: Qt.AlignVCenter | Qt.AlignRight
+
+            sourceComponent: {
+                if (root.row.special === "theme")
+                    return themeControl
+                if (root.row.special === "button")
+                    return buttonControl
+                if (!root.opt?.name)
+                    return null
+
+                switch (root.opt.type) {
+                case "bool":
+                    return toggleControl
+                case "color":
+                    return colorControl
+                case "file":
+                case "directory":
+                    return pathControl
+                }
+                if (root.choices.length > 0)
+                    return dropdownControl
+                if (root.opt.type === "int" || root.opt.type === "float") {
+                    const range = root.opt.max - root.opt.min
+                    if (root.opt.max > root.opt.min && range <= 1000 && !root.row.unit)
+                        return sliderControl
+                    return numberControl
+                }
+                return textControl
+            }
+        }
+    }
+
+    // ON/OFF switch: a square knob with the state written next to it
+    Component {
+        id: toggleControl
+
+        T.AbstractButton {
+            id: toggle
+
+            readonly property bool on: !!root.opt.value
+
+            implicitWidth: VLCStyle.dp(68, VLCStyle.scale)
+            implicitHeight: VLCStyle.dp(32, VLCStyle.scale)
+
+            Accessible.role: Accessible.CheckBox
+            Accessible.name: root.label
+            Accessible.checked: on
+            // Screen readers (and UI Automation) toggle checkboxes rather than click them
+            Accessible.onToggleAction: root._set(!on)
+            Accessible.onPressAction: root._set(!on)
+
+            onClicked: root._set(!on)
+
+            background: Rectangle {
+                radius: VLCStyle.dp(4, VLCStyle.scale)
+                color: toggle.on ? fieldTheme.bg.secondary : theme.bg.secondary
+                border.width: VLCStyle.border
+                border.color: toggle.on ? fieldTheme.bg.secondary : viewTheme.border
+
+                Rectangle {
+                    x: toggle.on ? parent.width - width - VLCStyle.dp(4, VLCStyle.scale) : VLCStyle.dp(4, VLCStyle.scale)
+                    anchors.verticalCenter: parent.verticalCenter
+                    width: VLCStyle.dp(24, VLCStyle.scale)
+                    height: width
+                    radius: VLCStyle.dp(3, VLCStyle.scale)
+                    color: toggle.on ? theme.accent : viewTheme.border
+
+                    Behavior on x { NumberAnimation { duration: VLCStyle.duration_short } }
+                }
+
+                T.Label {
+                    x: toggle.on ? VLCStyle.dp(10, VLCStyle.scale) : parent.width - width - VLCStyle.dp(8, VLCStyle.scale)
+                    anchors.verticalCenter: parent.verticalCenter
+                    text: toggle.on ? qsTr("ON") : qsTr("OFF")
+                    color: toggle.on ? theme.accent : theme.fg.secondary
+                    font.pixelSize: VLCStyle.fontSize_normal
+                }
+            }
+        }
+    }
+
+    // Dropdown of the option's choices (or the row's own wording)
+    Component {
+        id: dropdownControl
+
+        T.ComboBox {
+            id: combo
+
+            implicitWidth: root.controlWidth
+            implicitHeight: VLCStyle.dp(36, VLCStyle.scale)
+
+            model: root.choices
+            textRole: "text"
+            valueRole: "value"
+
+            currentIndex: {
+                for (let i = 0; i < root.choices.length; ++i) {
+                    if (String(root.choices[i].value) === String(root.opt.value))
+                        return i
+                }
+                return -1
+            }
+
+            displayText: currentIndex >= 0 ? root.choices[currentIndex].text : String(root.opt.value)
+
+            onActivated: (index) => root._set(root.choices[index].value)
+
+            background: Rectangle {
+                radius: VLCStyle.dp(4, VLCStyle.scale)
+                color: theme.bg.secondary
+                border.width: combo.visualFocus ? VLCStyle.border : 0
+                border.color: theme.accent
+            }
+
+            contentItem: T.Label {
+                leftPadding: VLCStyle.dp(14, VLCStyle.scale)
+                rightPadding: VLCStyle.dp(40, VLCStyle.scale)
+                verticalAlignment: Text.AlignVCenter
+                text: combo.displayText
+                color: viewTheme.fg.primary
+                font.pixelSize: VLCStyle.fontSize_large
+                elide: Text.ElideRight
+            }
+
+            indicator: Widgets.IconLabel {
+                x: combo.width - width - VLCStyle.dp(12, VLCStyle.scale)
+                anchors.verticalCenter: parent.verticalCenter
+                text: VLCIcons.chevron_down
+                color: viewTheme.fg.primary
+                font.pixelSize: VLCStyle.icon_normal
+            }
+
+            delegate: T.ItemDelegate {
+                required property var modelData
+                required property int index
+
+                width: combo.width - 2 * VLCStyle.dp(4, VLCStyle.scale)
+                implicitHeight: VLCStyle.dp(32, VLCStyle.scale)
+
+                highlighted: combo.highlightedIndex === index
+
+                background: Rectangle {
+                    radius: VLCStyle.dp(3, VLCStyle.scale)
+                    color: (parent.highlighted || parent.hovered) ? viewTheme.border : "transparent"
+                }
+
+                contentItem: T.Label {
+                    leftPadding: VLCStyle.dp(10, VLCStyle.scale)
+                    verticalAlignment: Text.AlignVCenter
+                    text: modelData.text
+                    color: index === combo.currentIndex ? theme.accent : viewTheme.fg.primary
+                    font.pixelSize: VLCStyle.fontSize_large
+                    elide: Text.ElideRight
+                }
+            }
+
+            popup: T.Popup {
+                y: combo.height + VLCStyle.dp(4, VLCStyle.scale)
+                width: combo.width
+                implicitHeight: Math.min(contentItem.implicitHeight + 2 * padding, VLCStyle.dp(320, VLCStyle.scale))
+                padding: VLCStyle.dp(4, VLCStyle.scale)
+
+                contentItem: ListView {
+                    clip: true
+                    implicitHeight: contentHeight
+                    model: combo.popup.visible ? combo.delegateModel : null
+                    currentIndex: combo.highlightedIndex
+                    boundsBehavior: Flickable.StopAtBounds
+                }
+
+                background: Rectangle {
+                    radius: VLCStyle.dp(6, VLCStyle.scale)
+                    color: theme.bg.secondary
+                    border.width: VLCStyle.border
+                    border.color: viewTheme.border
+                }
+            }
+        }
+    }
+
+    // Slider for small numeric ranges, with the value shown next to it
+    Component {
+        id: sliderControl
+
+        RowLayout {
+            implicitWidth: root.controlWidth
+            width: implicitWidth
+            spacing: VLCStyle.dp(12, VLCStyle.scale)
+
+            T.Slider {
+                id: slider
+
+                Layout.fillWidth: true
+                implicitHeight: VLCStyle.dp(28, VLCStyle.scale)
+
+                from: root.opt.min
+                to: root.opt.max
+                value: root.opt.value
+                stepSize: root.opt.type === "int" ? 1 : 0
+                live: true
+
+                onMoved: root._set(root.opt.type === "int" ? Math.round(value) : value)
+
+                background: Rectangle {
+                    x: slider.leftPadding
+                    y: slider.topPadding + (slider.availableHeight - height) / 2
+                    width: slider.availableWidth
+                    height: VLCStyle.dp(8, VLCStyle.scale)
+                    radius: height / 2
+                    color: theme.bg.secondary
+
+                    Rectangle {
+                        width: slider.visualPosition * parent.width
+                        height: parent.height
+                        radius: parent.radius
+                        color: fieldTheme.bg.secondary
+                    }
+                }
+
+                handle: Rectangle {
+                    x: slider.leftPadding + slider.visualPosition * (slider.availableWidth - width)
+                    y: slider.topPadding + (slider.availableHeight - height) / 2
+                    width: VLCStyle.dp(8, VLCStyle.scale)
+                    height: VLCStyle.dp(20, VLCStyle.scale)
+                    radius: VLCStyle.dp(3, VLCStyle.scale)
+                    color: theme.accent
+                }
+            }
+
+            T.Label {
+                Layout.preferredWidth: VLCStyle.dp(48, VLCStyle.scale)
+                horizontalAlignment: Text.AlignRight
+                text: root.opt.type === "int" ? String(root.opt.value) : Number(root.opt.value).toFixed(2)
+                color: viewTheme.fg.primary
+                font.pixelSize: VLCStyle.fontSize_large
+            }
+        }
+    }
+
+    // Free number field, for large ranges and values with a unit
+    Component {
+        id: numberControl
+
+        FieldBox {
+            implicitWidth: VLCStyle.dp(140, VLCStyle.scale)
+
+            text: root.opt.type === "float" ? Number(root.opt.value).toString() : String(root.opt.value)
+            unit: root.row.unit ?? ""
+            validator: root.opt.type === "float" ? doubleValidator : intValidator
+
+            onCommitted: (text) => {
+                const value = root.opt.type === "float" ? parseFloat(text) : parseInt(text)
+                if (!isNaN(value))
+                    root._set(value)
+            }
+
+            IntValidator { id: intValidator }
+            DoubleValidator { id: doubleValidator }
+        }
+    }
+
+    // Text field (password options are masked)
+    Component {
+        id: textControl
+
+        FieldBox {
+            implicitWidth: root.controlWidth
+
+            text: String(root.opt.value ?? "")
+            echoMode: root.opt.type === "password" ? TextInput.Password : TextInput.Normal
+
+            onCommitted: (text) => root._set(text)
+        }
+    }
+
+    // Path field with a Browse button
+    Component {
+        id: pathControl
+
+        RowLayout {
+            implicitWidth: root.controlWidth
+            width: implicitWidth
+            spacing: VLCStyle.dp(10, VLCStyle.scale)
+
+            FieldBox {
+                Layout.fillWidth: true
+
+                text: String(root.opt.value ?? "")
+                onCommitted: (text) => root._set(text)
+            }
+
+            FlatButton {
+                text: qsTr("Browse")
+                onClicked: {
+                    if (VLCSettings.browse(root.row.option).length > 0)
+                        root.opt = root._load()
+                }
+            }
+        }
+    }
+
+    // Color swatch with its hex value
+    Component {
+        id: colorControl
+
+        RowLayout {
+            width: implicitWidth
+            spacing: VLCStyle.dp(10, VLCStyle.scale)
+
+            Rectangle {
+                implicitWidth: VLCStyle.dp(32, VLCStyle.scale)
+                implicitHeight: VLCStyle.dp(32, VLCStyle.scale)
+                radius: VLCStyle.dp(4, VLCStyle.scale)
+                color: "#" + ("000000" + Number(root.opt.value).toString(16)).slice(-6)
+                border.width: VLCStyle.border
+                border.color: viewTheme.border
+            }
+
+            FieldBox {
+                implicitWidth: VLCStyle.dp(120, VLCStyle.scale)
+
+                text: "#" + ("000000" + Number(root.opt.value).toString(16).toUpperCase()).slice(-6)
+                validator: RegularExpressionValidator { regularExpression: /#?[0-9a-fA-F]{6}/ }
+
+                onCommitted: (text) => root._set(parseInt(text.replace("#", ""), 16))
+            }
+        }
+    }
+
+    // Dark / Light / System segmented switch for the color scheme
+    Component {
+        id: themeControl
+
+        Row {
+            spacing: VLCStyle.dp(2, VLCStyle.scale)
+
+            Repeater {
+                // ColorSchemeModel.ColorScheme: System = 0, Day = 1, Night = 2
+                model: [
+                    { scheme: 2, text: qsTr("Dark") },
+                    { scheme: 1, text: qsTr("Light") },
+                    { scheme: 0, text: qsTr("System") }
+                ]
+
+                T.AbstractButton {
+                    required property var modelData
+
+                    readonly property bool active: MainCtx.colorScheme.scheme === modelData.scheme
+
+                    width: (root.controlWidth - 2 * VLCStyle.dp(2, VLCStyle.scale)) / 3
+                    height: VLCStyle.dp(32, VLCStyle.scale)
+
+                    onClicked: MainCtx.colorScheme.setScheme(modelData.scheme)
+
+                    background: Rectangle {
+                        radius: VLCStyle.dp(4, VLCStyle.scale)
+                        color: parent.active ? fieldTheme.bg.secondary : theme.bg.secondary
+                    }
+
+                    contentItem: T.Label {
+                        horizontalAlignment: Text.AlignHCenter
+                        verticalAlignment: Text.AlignVCenter
+                        text: modelData.text
+                        color: parent.active ? theme.accent : viewTheme.fg.primary
+                        font.pixelSize: VLCStyle.fontSize_large
+                    }
+                }
+            }
+        }
+    }
+
+    // Action button (open folder, reset, classic preferences, ...)
+    Component {
+        id: buttonControl
+
+        FlatButton {
+            text: root.row.text
+            accent: !!root.row.accent
+
+            onClicked: {
+                switch (root.row.action) {
+                case "openConfigFolder":
+                    VLCSettings.openConfigFolder()
+                    break
+                case "resetAll":
+                    if (DialogsProvider.questionDialog(qsTr("Reset all VLC settings to their defaults?"), qsTr("Reset all settings")))
+                        VLCSettings.resetAll()
+                    break
+                case "classic":
+                    DialogsProvider.classicPrefsDialog()
+                    break
+                case "plugins":
+                    DialogsProvider.pluginDialog()
+                    break
+                }
+            }
+        }
+    }
+
+    // Dark rounded field used by text, number and path controls
+    component FieldBox: Rectangle {
+        id: fieldBox
+
+        // inline components do not see the ids of the enclosing file
+        ColorContext { id: fbWindow; colorSet: ColorContext.Window }
+        ColorContext { id: fbField; colorSet: ColorContext.Slider }
+        ColorContext { id: fbView; colorSet: ColorContext.View }
+
+        property alias text: input.text
+        property alias validator: input.validator
+        property alias echoMode: input.echoMode
+        property string unit
+
+        signal committed(string text)
+
+        implicitHeight: VLCStyle.dp(36, VLCStyle.scale)
+        radius: VLCStyle.dp(4, VLCStyle.scale)
+        color: fbField.bg.primary
+        border.width: input.activeFocus ? VLCStyle.border : 0
+        border.color: fbWindow.accent
+
+        TextInput {
+            id: input
+
+            anchors.fill: parent
+            anchors.leftMargin: VLCStyle.dp(12, VLCStyle.scale)
+            anchors.rightMargin: VLCStyle.dp(12, VLCStyle.scale) + (unitLabel.visible ? unitLabel.width + VLCStyle.dp(6, VLCStyle.scale) : 0)
+
+            verticalAlignment: TextInput.AlignVCenter
+            clip: true
+            selectByMouse: true
+
+            color: fbView.fg.primary
+            selectionColor: fbField.bg.secondary
+            font.pixelSize: VLCStyle.fontSize_large
+
+            onEditingFinished: fieldBox.committed(text)
+        }
+
+        T.Label {
+            id: unitLabel
+
+            anchors.right: parent.right
+            anchors.rightMargin: VLCStyle.dp(12, VLCStyle.scale)
+            anchors.verticalCenter: parent.verticalCenter
+
+            visible: fieldBox.unit.length > 0
+            text: fieldBox.unit
+            color: fbWindow.fg.secondary
+            font.pixelSize: VLCStyle.fontSize_large
+        }
+    }
+
+    // Flat rectangular button (#373737, orange text for destructive actions)
+    component FlatButton: T.AbstractButton {
+        id: flatButton
+
+        property bool accent: false
+
+        ColorContext { id: btWindow; colorSet: ColorContext.Window }
+        ColorContext { id: btField; colorSet: ColorContext.Slider }
+        ColorContext { id: btView; colorSet: ColorContext.View }
+
+        implicitWidth: Math.max(VLCStyle.dp(96, VLCStyle.scale), buttonLabel.implicitWidth + VLCStyle.dp(32, VLCStyle.scale))
+        implicitHeight: VLCStyle.dp(36, VLCStyle.scale)
+
+        background: Rectangle {
+            radius: VLCStyle.dp(4, VLCStyle.scale)
+            color: flatButton.accent ? btField.bg.secondary : btView.border
+            opacity: flatButton.hovered ? 0.8 : 1.0
+        }
+
+        contentItem: T.Label {
+            id: buttonLabel
+
+            horizontalAlignment: Text.AlignHCenter
+            verticalAlignment: Text.AlignVCenter
+            text: flatButton.text
+            color: flatButton.accent ? btWindow.accent : btView.fg.primary
+            font.pixelSize: VLCStyle.fontSize_large
+            font.weight: Font.DemiBold
+        }
+    }
+}
