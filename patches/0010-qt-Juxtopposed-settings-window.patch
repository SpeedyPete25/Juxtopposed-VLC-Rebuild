diff --git a/modules/gui/qt/dialogs/preferences/vlc_settings.cpp b/modules/gui/qt/dialogs/preferences/vlc_settings.cpp
new file mode 100644
index 0000000..1a1df43
--- /dev/null
+++ b/modules/gui/qt/dialogs/preferences/vlc_settings.cpp
@@ -0,0 +1,267 @@
+/*****************************************************************************
+ * vlc_settings.cpp : VLC configuration access for the QML settings window
+ *****************************************************************************
+ * Copyright (C) 2026 VLC authors and VideoLAN
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * ( at your option ) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston MA 02110-1301, USA.
+ *****************************************************************************/
+
+#ifdef HAVE_CONFIG_H
+# include "config.h"
+#endif
+
+#include "dialogs/preferences/vlc_settings.hpp"
+
+#include <QDesktopServices>
+#include <QDir>
+#include <QFileDialog>
+#include <QUrl>
+
+#include <vlc_configuration.h>
+#include <vlc_modules.h>
+#include <vlc_plugin.h>
+
+namespace {
+
+QString typeName(int type)
+{
+    switch (type)
+    {
+    case CONFIG_ITEM_BOOL:        return QStringLiteral("bool");
+    case CONFIG_ITEM_INTEGER:     return QStringLiteral("int");
+    case CONFIG_ITEM_RGB:         return QStringLiteral("color");
+    case CONFIG_ITEM_FLOAT:       return QStringLiteral("float");
+    case CONFIG_ITEM_PASSWORD:    return QStringLiteral("password");
+    case CONFIG_ITEM_KEY:         return QStringLiteral("key");
+    case CONFIG_ITEM_LOADFILE:
+    case CONFIG_ITEM_SAVEFILE:    return QStringLiteral("file");
+    case CONFIG_ITEM_DIRECTORY:   return QStringLiteral("directory");
+    case CONFIG_ITEM_FONT:        return QStringLiteral("font");
+    case CONFIG_ITEM_MODULE:
+    case CONFIG_ITEM_MODULE_CAT:
+    case CONFIG_ITEM_MODULE_LIST:
+    case CONFIG_ITEM_MODULE_LIST_CAT: return QStringLiteral("module");
+    default:                      return QStringLiteral("string");
+    }
+}
+
+bool isStringType(int type)
+{
+    return IsConfigStringType(type);
+}
+
+} // namespace
+
+VLCSettings::VLCSettings(qt_intf_t *intf, QObject *parent)
+    : QObject(parent)
+    , m_intf(intf)
+{
+    // Batch quick successive changes (sliders) into one write of the file
+    m_saveTimer.setSingleShot(true);
+    m_saveTimer.setInterval(500);
+    connect(&m_saveTimer, &QTimer::timeout, this, &VLCSettings::save);
+}
+
+QVariantMap VLCSettings::option(const QString &name) const
+{
+    QVariantMap result;
+    const QByteArray utf8 = name.toUtf8();
+    const module_config_t *item = config_FindConfig(utf8.constData());
+    // Obsolete options are kept without any text: treat them as missing
+    if (!item || !CONFIG_ITEM(item->i_type) || !item->psz_text)
+        return result;
+
+    result[QStringLiteral("name")] = name;
+    result[QStringLiteral("type")] = typeName(item->i_type);
+    result[QStringLiteral("text")] = item->psz_text ? qfut(item->psz_text) : name;
+    result[QStringLiteral("longText")] = item->psz_longtext ? qfut(item->psz_longtext) : QString();
+
+    QVariantList choices;
+
+    if (isStringType(item->i_type))
+    {
+        char *value = config_GetPsz(utf8.constData());
+        result[QStringLiteral("value")] = qfu(value ? value : "");
+        free(value);
+        result[QStringLiteral("defaultValue")] = qfu(item->orig.psz ? item->orig.psz : "");
+
+        char **values, **texts;
+        ssize_t count = config_GetPszChoices(utf8.constData(), &values, &texts);
+        for (ssize_t i = 0; i < count; i++)
+        {
+            choices.append(QVariantMap{
+                { QStringLiteral("value"), qfu(values[i]) },
+                { QStringLiteral("text"), qfut(texts[i]) } });
+            free(values[i]);
+            free(texts[i]);
+        }
+        if (count >= 0)
+        {
+            free(values);
+            free(texts);
+        }
+    }
+    else if (item->i_type == CONFIG_ITEM_FLOAT)
+    {
+        result[QStringLiteral("value")] = config_GetFloat(utf8.constData());
+        result[QStringLiteral("defaultValue")] = item->orig.f;
+        result[QStringLiteral("min")] = item->min.f;
+        result[QStringLiteral("max")] = item->max.f;
+    }
+    else // bool, int, rgb
+    {
+        const qlonglong value = config_GetInt(utf8.constData());
+        if (item->i_type == CONFIG_ITEM_BOOL)
+        {
+            result[QStringLiteral("value")] = value != 0;
+            result[QStringLiteral("defaultValue")] = item->orig.i != 0;
+        }
+        else
+        {
+            result[QStringLiteral("value")] = value;
+            result[QStringLiteral("defaultValue")] = qlonglong(item->orig.i);
+            result[QStringLiteral("min")] = qlonglong(item->min.i);
+            result[QStringLiteral("max")] = qlonglong(item->max.i);
+
+            int64_t *values;
+            char **texts;
+            ssize_t count = config_GetIntChoices(utf8.constData(), &values, &texts);
+            for (ssize_t i = 0; i < count; i++)
+            {
+                choices.append(QVariantMap{
+                    { QStringLiteral("value"), qlonglong(values[i]) },
+                    { QStringLiteral("text"), qfut(texts[i]) } });
+                free(texts[i]);
+            }
+            if (count >= 0)
+            {
+                free(values);
+                free(texts);
+            }
+        }
+    }
+
+    result[QStringLiteral("choices")] = choices;
+    return result;
+}
+
+bool VLCSettings::setValue(const QString &name, const QVariant &value)
+{
+    const QByteArray utf8 = name.toUtf8();
+    const module_config_t *item = config_FindConfig(utf8.constData());
+    if (!item || !CONFIG_ITEM(item->i_type))
+        return false;
+
+    if (isStringType(item->i_type))
+        config_PutPsz(utf8.constData(), value.toString().toUtf8().constData());
+    else if (item->i_type == CONFIG_ITEM_FLOAT)
+        config_PutFloat(utf8.constData(), value.toFloat());
+    else if (item->i_type == CONFIG_ITEM_BOOL)
+        config_PutInt(utf8.constData(), value.toBool() ? 1 : 0);
+    else
+        config_PutInt(utf8.constData(), value.toLongLong());
+
+    m_saveTimer.start();
+    return true;
+}
+
+QVariantList VLCSettings::coreOptions(const QVariantList &subcategories) const
+{
+    QVariantList result;
+
+    module_t *main = module_get_main();
+    if (!main)
+        return result;
+
+    unsigned count;
+    module_config_t *const config = module_config_get(main, &count);
+    if (!config)
+        return result;
+
+    for (const QVariant &wanted : subcategories)
+    {
+        const int subcat = wanted.toInt();
+        bool inside = false;
+        for (unsigned i = 0; i < count; i++)
+        {
+            const module_config_t *item = &config[i];
+            if (item->i_type == CONFIG_SUBCATEGORY)
+            {
+                inside = (item->value.i == subcat);
+                continue;
+            }
+            if (!inside)
+                continue;
+
+            if (item->i_type == CONFIG_SECTION)
+                result.append(QVariantMap{ { QStringLiteral("section"), qfut(item->psz_text) } });
+            else if (CONFIG_ITEM(item->i_type) && item->psz_name && item->psz_text
+                     && item->i_type != CONFIG_ITEM_KEY)
+                result.append(QVariantMap{ { QStringLiteral("name"), qfu(item->psz_name) } });
+        }
+    }
+
+    module_config_free(config);
+    return result;
+}
+
+QString VLCSettings::browse(const QString &name)
+{
+    const QByteArray utf8 = name.toUtf8();
+    const module_config_t *item = config_FindConfig(utf8.constData());
+    if (!item || !IsConfigStringType(item->i_type))
+        return {};
+
+    char *current = config_GetPsz(utf8.constData());
+    const QString start = qfu(current ? current : "");
+    free(current);
+
+    const QString title = item->psz_text ? qfut(item->psz_text) : name;
+    QString path;
+    if (item->i_type == CONFIG_ITEM_DIRECTORY)
+        path = QFileDialog::getExistingDirectory(nullptr, title, start);
+    else if (item->i_type == CONFIG_ITEM_SAVEFILE)
+        path = QFileDialog::getSaveFileName(nullptr, title, start);
+    else
+        path = QFileDialog::getOpenFileName(nullptr, title, start);
+
+    if (path.isEmpty())
+        return {};
+    path = QDir::toNativeSeparators(path);
+    setValue(name, path);
+    return path;
+}
+
+void VLCSettings::resetAll()
+{
+    config_ResetAll();
+    save();
+    emit reset();
+}
+
+void VLCSettings::openConfigFolder() const
+{
+    char *dir = config_GetUserDir(VLC_CONFIG_DIR);
+    if (!dir)
+        return;
+    QDesktopServices::openUrl(QUrl::fromLocalFile(qfu(dir)));
+    free(dir);
+}
+
+void VLCSettings::save()
+{
+    m_saveTimer.stop();
+    config_SaveConfigFile(m_intf);
+}
