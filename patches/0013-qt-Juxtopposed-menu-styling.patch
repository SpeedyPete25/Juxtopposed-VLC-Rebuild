+// Juxtopposed: every context and main menu as a rounded dark card, 48px
+// rows with muted text and dim separators (Figma "context menu" frames).
+// The style is set on each menu as it is polished, so other widgets keep
+// the platform style. On Windows the rounded corners and the border come
+// from the window manager (Windows 11), which keeps the native shadow.
+class JuxtMenuStyler : public QObject
+{
+public:
+    explicit JuxtMenuStyler(QObject* parent) : QObject(parent) { }
+
+    bool eventFilter(QObject* object, QEvent* event) override
+    {
+#ifdef _WIN32
+        if (event->type() == QEvent::Show)
+        {
+            if (QMenu* menu = qobject_cast<QMenu*>(object))
+            {
+                const HWND hwnd = reinterpret_cast<HWND>(menu->winId());
+                const DWORD cornerPreference = 2; // DWMWCP_ROUND
+                const COLORREF borderColor = RGB(0x22, 0x22, 0x22);
+                DwmSetWindowAttribute(hwnd, 33 /* DWMWA_WINDOW_CORNER_PREFERENCE */,
+                                      &cornerPreference, sizeof(cornerPreference));
+                DwmSetWindowAttribute(hwnd, 34 /* DWMWA_BORDER_COLOR */,
+                                      &borderColor, sizeof(borderColor));
+            }
+            return false;
+        }
+#endif
+        if (event->type() != QEvent::Polish)
+            return false;
+
+        QMenu* menu = qobject_cast<QMenu*>(object);
+        if (!menu || !menu->styleSheet().isEmpty())
+            return false;
+
+        menu->setStyleSheet(QStringLiteral(R"RAW(
+            QMenu {
+                background: #191919;
+                border: none;
+                padding: 4px;
+                color: #969696;
+                font-size: 14px;
+                icon-size: 24px;
+            }
+            QMenu::item {
+                padding: 13px 24px 13px 12px;
+                min-width: 180px;
+                border-radius: 6px;
+                background: transparent;
+            }
+            QMenu::item:selected {
+                background: #262626;
+                color: #C8C8C8;
+            }
+            QMenu::item:disabled {
+                color: #404040;
+            }
+            QMenu::icon {
+                padding-left: 14px;
+            }
+            QMenu::right-arrow {
+                image: url(:/menu/juxt_chevron_right.svg);
+                width: 24px;
+                height: 24px;
+                right: 8px;
+            }
+            QMenu::separator {
+                height: 1px;
+                background: #222222;
+                margin: 0px 4px;
+            }
+        )RAW"));
+        return false;
+    }
+};
+
 /*****************************************************************************
  * Module callbacks
  *****************************************************************************/
@@ -1483,6 +1563,8 @@ static void *Thread( void *obj )
     }
 #undef QTSTYLE_KEY
 
+    app.installEventFilter( new JuxtMenuStyler( &app ) );
+
     /* Launch */
     app.exec();
 
