-                    { value: "#9B6BFF", color: "#9B6BFF", text: qsTr("Purple") },
-                    { value: "#3D8BFD", color: "#3D8BFD", text: qsTr("Blue") },
-                    { value: "#2FB36B", color: "#2FB36B", text: qsTr("Green") },
-                    { value: "#E0B321", color: "#E0B321", text: qsTr("Yellow") }
+                    { value: "#782F20", color: "#782F20", text: qsTr("Red") },
+                    { value: "#695619", color: "#695619", text: qsTr("Olive") },
+                    { value: "#145821", color: "#145821", text: qsTr("Green") },
+                    { value: "#135C71", color: "#135C71", text: qsTr("Teal") },
+                    { value: "#133671", color: "#133671", text: qsTr("Blue") },
+                    { value: "#4E2887", color: "#4E2887", text: qsTr("Purple") },
+                    { value: "#7F3061", color: "#7F3061", text: qsTr("Plum") },
+                    { value: "#5F5F5F", color: "#5F5F5F", text: qsTr("Gray") }
                 ]
 
                 T.AbstractButton {
@@ -506,10 +508,10 @@ Item {
                         return current === modelData.value.toLowerCase()
