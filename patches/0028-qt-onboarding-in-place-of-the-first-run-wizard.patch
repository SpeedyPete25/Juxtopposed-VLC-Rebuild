+QString VLCSettings::defaultMediaFolder() const
+{
+    const QString videos = QStandardPaths::writableLocation(QStandardPaths::MoviesLocation);
+    return QDir::toNativeSeparators(videos.isEmpty() ? QDir::homePath() : videos);
+}
+
+QString VLCSettings::chooseFolder(const QString &start)
+{
+    const QString path = QFileDialog::getExistingDirectory(nullptr, qtr("Choose a media folder"),
+                                                           start.isEmpty() ? QDir::homePath() : start);
+    return path.isEmpty() ? QString() : QDir::toNativeSeparators(path);
+}
+
+void VLCSettings::finishOnboarding(const QString &mediaFolder)
+{
+    if (!mediaFolder.isEmpty())
+    {
+        if (vlc_medialibrary_t *ml = vlc_ml_instance_get(m_intf))
+        {
+            const QByteArray mrl = QUrl::fromLocalFile(mediaFolder).toString(QUrl::FullyEncoded).toUtf8();
+            vlc_ml_add_folder(ml, mrl.constData());
+        }
+    }
+
+    // what VLC's first run wizard ends with; the privacy choice it asked
+    // about (metadata-network-access) is left as it is, in Settings > Privacy
+    config_PutInt("qt-privacy-ask", 0);
+    save();
+}
