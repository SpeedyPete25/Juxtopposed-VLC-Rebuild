+// Juxtopposed: the two-tone (orange and gray) menu icons of the redesign
+static QIcon juxtMenuIcon(const char *name)
+{
+    return QIcon(QStringLiteral(":/menu/juxt_%1.svg").arg(QLatin1String(name)));
+}
+
 void StringListMenu::popup(const QPoint &point, const QVariantList &stringList)
 {
     assert(m_ctx);
@@ -842,13 +848,21 @@ void PlaylistListContextMenu::popup(const QModelIndexList & selected, QPoint pos
 
     MediaLib * ml = m_model->ml();
 
-    QAction * action = menu->addAction(qtr("Add and play"));
+    QAction * action = menu->addAction(juxtMenuIcon("play"), qtr("Play"));
 
     connect(action, &QAction::triggered, [ml, ids]() {
         ml->addAndPlay(ids);
     });
 
-    action = menu->addAction(qtr("Enqueue"));
+    action = menu->addAction(juxtMenuIcon("shuffle"), qtr("Shuffle"));
+
+    qt_intf_t *p_intf = m_ctx->getIntf();
+    connect(action, &QAction::triggered, [p_intf, ml, ids]() {
+        THEMPL->setRandom(true);
+        ml->addAndPlay(ids);
+    });
+
+    action = menu->addAction(juxtMenuIcon("queue"), qtr("Add to Queue"));
 
     connect(action, &QAction::triggered, [ml, ids]() {
         ml->addToPlaylist(ids);
@@ -894,32 +908,32 @@ void PlaylistMediaContextMenu::popup(const QModelIndexList & selected, QPoint po
 
