 modules/gui/qt/assets.qrc                     |  4 ++
 modules/gui/qt/menus/qml_menu_wrapper.cpp     | 66 ++++++++++++-------
 modules/gui/qt/pixmaps/menu/juxt_add.svg      |  6 ++
 .../gui/qt/pixmaps/menu/juxt_add_folder.svg   |  7 ++
